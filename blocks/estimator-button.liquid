    color: #0a2e5c;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .estimator-stepper-btn:hover {
    background: #e2e8f0;
  }

  .estimator-stepper-input {
    flex: 1;
    border: none !important;
    text-align: center;
    font-weight: 700;
    font-size: 14px;

    border: 1px solid #feb2b2;
  }

  .estimator-alert--success {
    background: #f0fff4;
    color: #276749;
    border: 1px solid #9ae6b4;
    text-align: center;
    padding: 20px;
    font-weight: 600;
  }

  .estimator-actions {
    margin-top: 6px;
    margin-bottom: 12px;
  }

  .estimator-submit-btn {
    width: 100%;
    padding: 13px 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f5a623;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(245, 166, 35, 0.4);
    transition: all 0.2s ease;
  }

  .estimator-submit-btn:hover {
    background: #d9921b;
  }

  .estimator-security-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
    text-align: center;
  }

  /* Spinner */
  .spinner-svg {
    animation: rotate 1.5s linear infinite;
    width: 18px;
    height: 18px;
    margin-left: 8px;
  }

  .spinner-svg .path {
    stroke: #ffffff;
    stroke-linecap: round;
    animation: dash 1.5s ease-in-out infinite;
  }

  @keyframes rotate {
    100% { transform: rotate(360deg); }
  }

  @keyframes dash {
    0% {
      stroke-dasharray: 1, 150;
      stroke-dashoffset: 0;
    }
    50% {
      stroke-dasharray: 90, 150;
      stroke-dashoffset: -35;
    }
    100% {
      stroke-dasharray: 90, 150;
      stroke-dashoffset: -124;
    }
  }

  @media (max-width: 600px) {
    .estimator-modal-dialog {
      padding: 22px 18px;
    }
    .estimator-field-row {
      flex-direction: column;
      gap: 0;
    }

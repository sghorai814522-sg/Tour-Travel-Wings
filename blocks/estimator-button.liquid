{% liquid
  assign product_target = closest.product | default: product
  if product_target == blank and request.visual_preview_mode
    assign product_target = collections.all.products.first
  endif
  assign product = product_target
  assign current_variant = product.selected_or_first_available_variant
  assign block_settings = block.settings

  if product.featured_image
    assign default_product_image = product.featured_image | image_url: width: 300
    unless default_product_image contains 'http://' or default_product_image contains 'https:'
      assign default_product_image = default_product_image | prepend: 'https:'
    endunless
  else
    assign default_product_image = ''
  endif
%}

<script type="application/json" id="EstimatorVariantPrices-{{ block.id }}">
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": {{ variant.price | money | strip_html | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>
<script type="application/json" id="EstimatorVariantImages-{{ block.id }}">
  {
    {%- for variant in product.variants -%}
      {%- if variant.featured_image -%}
        {%- assign v_img = variant.featured_image | image_url: width: 300 -%}
        {%- unless v_img contains 'http://' or v_img contains 'https:' -%}
          {%- assign v_img = v_img | prepend: 'https:' -%}
        {%- endunless -%}
      {%- else -%}
        {%- assign v_img = default_product_image -%}
      {%- endif -%}
      "{{ variant.id }}": {{ v_img | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<!-- Estimator / Book Now Button Block -->
<div class="estimator-block-wrapper" {{ block.shopify_attributes }}>
  <button
    type="button"
    class="moko-btn estimator-open-btn"
    id="EstimatorOpenBtn-{{ block.id }}"
    aria-haspopup="dialog"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
    <span>{{ block_settings.button_text | default: "Book Now" }}</span>
  </button>
</div>

<!-- Hidden native Shopify Contact Form backup -->
{%- assign shopify_fallback_form_id = 'EstimatorFallbackForm-' | append: block.id -%}
<div style="display: none !important;">
  {%- form 'contact', id: shopify_fallback_form_id -%}
    <input type="text" name="contact[name]" id="FallbackName-{{ block.id }}">
    <input type="email" name="contact[email]" id="FallbackEmail-{{ block.id }}">
    <input type="tel" name="contact[phone]" id="FallbackPhone-{{ block.id }}">
    <textarea name="contact[body]" id="FallbackBody-{{ block.id }}"></textarea>
  {%- endform -%}
</div>

<!-- Modal Popup -->
<div class="estimator-modal-overlay" id="EstimatorModal-{{ block.id }}" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="EstimatorTitle-{{ block.id }}">
  <div class="estimator-modal-backdrop" id="EstimatorBackdrop-{{ block.id }}"></div>
  <div class="estimator-modal-dialog">
    <button type="button" class="estimator-modal-close" id="EstimatorClose-{{ block.id }}" aria-label="Close modal">&times;</button>
    
    <div class="estimator-modal-header">
      <h3 id="EstimatorTitle-{{ block.id }}">{{ block_settings.heading | default: "Book Your Dream Tour" }}</h3>
      <p>{{ block_settings.subheading | default: "Fill out your travel details below and our luxury travel specialists will reserve your itinerary." }}</p>
    </div>

    <!-- Product Summary Card -->
    <div class="estimator-product-summary">
      {% if product.featured_image %}
        <div class="estimator-product-img">
          <img src="{{ product.featured_image | image_url: width: 140 }}" alt="{{ product.title | escape }}" loading="lazy" width="70" height="70">
        </div>
      {% endif %}
      <div class="estimator-product-info">
        <h4 class="estimator-product-title">{{ product.title }}</h4>
        <div class="estimator-variant-badge">
          <span id="EstimatorVariantDisplay-{{ block.id }}">
            {% unless current_variant.title contains 'Default' %}
              {{ current_variant.title }}
            {% endunless %}
          </span>
        </div>
        <div class="estimator-price-badge" id="EstimatorPriceDisplay-{{ block.id }}">
          {{ current_variant.price | money }}
        </div>
      </div>
    </div>

    <!-- Booking Form -->
    <form class="estimator-form" id="EstimatorForm-{{ block.id }}">
      <div class="estimator-field-group">
        <label for="EstimatorName-{{ block.id }}">Full Name <span class="required">*</span></label>
        <input type="text" id="EstimatorName-{{ block.id }}" name="name" required placeholder="e.g. Rahul Sharma" maxlength="120">
      </div>

      <div class="estimator-field-row">
        <div class="estimator-field-group">
          <label for="EstimatorEmail-{{ block.id }}">Email Address <span class="required">*</span></label>
          <input type="email" id="EstimatorEmail-{{ block.id }}" name="email" required placeholder="e.g. rahul@example.com" maxlength="254">
        </div>

        <div class="estimator-field-group">
          <label for="EstimatorPhone-{{ block.id }}">Mobile / Phone <span class="required">*</span></label>
          <input type="tel" id="EstimatorPhone-{{ block.id }}" name="phone" required placeholder="e.g. +91 98765 43210" maxlength="40">
        </div>
      </div>

      <div class="estimator-field-row">
        <div class="estimator-field-group">
          <label for="EstimatorTravelDate-{{ block.id }}">Travel Date <span class="required">*</span></label>
          <input type="date" id="EstimatorTravelDate-{{ block.id }}" name="travel_date" required>
        </div>

        <div class="estimator-field-group">
          <label for="EstimatorQuantity-{{ block.id }}">Number of Travelers <span class="required">*</span></label>
          <div class="estimator-stepper-wrap">
            <button type="button" class="estimator-stepper-btn" id="EstimatorDec-{{ block.id }}">&minus;</button>
            <input type="number" id="EstimatorQuantity-{{ block.id }}" name="quantity" min="1" max="50" value="2" required class="estimator-stepper-input">
            <button type="button" class="estimator-stepper-btn" id="EstimatorInc-{{ block.id }}">&plus;</button>
          </div>
        </div>
      </div>

      <div class="estimator-field-group">
        <label for="EstimatorNotes-{{ block.id }}">Special Requests / Message (Optional)</label>
        <textarea id="EstimatorNotes-{{ block.id }}" name="notes" rows="3" placeholder="Hotel preferences, meal choices, flight assistance, etc." maxlength="800"></textarea>
      </div>

      <!-- Feedback Messages -->
      <div class="estimator-alert estimator-alert--error" id="EstimatorError-{{ block.id }}" style="display: none;"></div>
      <div class="estimator-alert estimator-alert--success" id="EstimatorSuccess-{{ block.id }}" style="display: none;">
        {{ block_settings.success_message | default: "Thank you! Your booking request has been submitted successfully. A confirmation has been sent to your email and our concierge will contact you shortly." }}
      </div>

      <div class="estimator-actions">
        <button type="submit" class="moko-btn estimator-submit-btn" id="EstimatorSubmitBtn-{{ block.id }}">
          <span class="btn-text">Confirm Booking Request</span>
          <span class="btn-spinner" style="display: none;">
            <svg class="spinner-svg" viewBox="0 0 50 50">
              <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
            </svg>
          </span>
        </button>
      </div>

      <div class="estimator-security-note">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>No advance payment needed today &bull; Verified booking request</span>
      </div>
    </form>
  </div>
</div>


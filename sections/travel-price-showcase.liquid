{% comment %}
  Travel Shop By Price Section (Hotels & Resorts by Budget)
  Tour & Travel Wings
  Features:
  - Exact reference design match ("Shop By Price")
  - Centered Title, Subtitle, and Gold Divider
  - 5 cards visible on desktop, 3 on tablet, 2 on mobile
  - Infinite circular carousel (clicking < and > always slides smoothly, never gets stuck!)
  - Auto-slide with pause-on-hover
  - Floating bottom white pill badge with price & hotel category
  - Full mobile touch-swipe support
{% endcomment %}

<section
  id="TravelPriceShowcase-{{ section.id }}"
  class="travel-price-showcase-section"
  style="
    --tps-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --tps-padding-top: {{ section.settings.padding_top | default: 50 }}px;
    --tps-padding-bottom: {{ section.settings.padding_bottom | default: 55 }}px;
  "
>
  <div class="tps-container">
    
    <!-- Section Header (Centered) -->
    <div class="tps-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="tps-title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="tps-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <div class="tps-divider"></div>
      {%- endif -%}
    </div>

    <!-- Carousel Slider Wrapper -->
    <div class="tps-carousel-wrapper">
      
      <!-- Nav Button: Prev (<) -->
      <button
        type="button"
        class="tps-nav-btn tps-nav-btn--prev"
        aria-label="Previous hotel price bracket"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Viewport & Track -->
      <div class="tps-viewport">
        <div class="tps-track">
          {%- comment -%} Render 2 duplicate sets for seamless infinite loop {%- endcomment -%}
          {%- for set_idx in (1..2) -%}
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign card_title = block.settings.title | default: 'Luxury Hotel'
                  assign card_price = block.settings.price_badge | default: '5K - 10K'
                  assign card_category = block.settings.category_label | default: 'Boutique Hotel'
                  assign card_link = block.settings.url | default: '#'

                  assign img_url = ''
                  if block.settings.image != blank
                    assign img_url = block.settings.image | image_url: width: 800
                  elsif block.settings.external_image_url != blank
                    assign img_url = block.settings.external_image_url
                  elsif block.settings.fallback_image != blank
                    assign img_url = block.settings.fallback_image | asset_url
                  else
                    case forloop.index
                      when 1
                        assign img_url = 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80'
                      when 2
                        assign img_url = 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80'
                      when 3
                        assign img_url = 'https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=800&q=80'
                      when 4
                        assign img_url = 'https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&fit=crop&w=800&q=80'
                      when 5
                        assign img_url = 'https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?auto=format&fit=crop&w=800&q=80'
                      when 6
                        assign img_url = 'https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80'
                      when 7
                        assign img_url = 'https://images.unsplash.com/photo-1514282401047-d79a71a590e8?auto=format&fit=crop&w=800&q=80'
                      else
                        assign img_url = 'hero-maldives.jpg' | asset_url
                    endcase
                  endif
                -%}

                <div class="tps-slide" {% if set_idx == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  <a href="{{ card_link }}" class="tps-card" aria-label="{{ card_title }} - {{ card_price }}">
                    <div class="tps-card-media">
                      <img
                        src="{{ img_url }}"
                        alt="{{ card_title | escape }}"
                        class="tps-card-img"
                        loading="lazy"
                        width="400"
                        height="530"
                      >
                      <div class="tps-card-overlay"></div>
                    </div>

                    <!-- Floating Bottom White Price Pill Badge (Exact Reference Match) -->
                    <div class="tps-badge-pill">
                      <span class="tps-price-text">{{ card_price }}</span>
                      {%- if card_category != blank -%}
                        <span class="tps-category-text">{{ card_category }}</span>
                      {%- endif -%}
                    </div>
                  </a>
                </div>
              {%- endfor -%}

            {%- else -%}
              <!-- Default 7 Brackets with Real Luxury Hotel Imagery -->
              {%- assign default_prices = '5K - 10K,10K - 20K,20K - 30K,30K - 40K,40K - 50K,Premium,Luxury' | split: ',' -%}
              {%- assign default_cats = 'Boutique Hotel,Hilltop Resort,Beachfront Resort,Heritage Palace,5-Star Luxury Suite,Private Pool Villa,Overwater Villa' | split: ',' -%}
              {%- assign default_imgs = 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1514282401047-d79a71a590e8?auto=format&fit=crop&w=800&q=80' | split: ',' -%}

              {%- for price_label in default_prices -%}
                {%- assign img_url = default_imgs[forloop.index0] -%}
                {%- assign cat_label = default_cats[forloop.index0] -%}

                <div class="tps-slide">
                  <a href="#" class="tps-card" aria-label="Explore {{ cat_label }} - {{ price_label }}">
                    <div class="tps-card-media">
                      <img
                        src="{{ img_url }}"
                        alt="{{ cat_label }}"
                        class="tps-card-img"
                        loading="lazy"
                        width="400"
                        height="530"
                      >
                      <div class="tps-card-overlay"></div>
                    </div>

                    <!-- Floating Bottom White Price Pill Badge (Exact Reference Match) -->
                    <div class="tps-badge-pill">
                      <span class="tps-price-text">{{ price_label }}</span>
                      <span class="tps-category-text">{{ cat_label }}</span>
                    </div>
                  </a>
                </div>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- Nav Button: Next (>) -->
      <button
        type="button"
        class="tps-nav-btn tps-nav-btn--next"
        aria-label="Next hotel price bracket"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

    </div>

  </div>
</section>

<style>
  .travel-price-showcase-section {
    background-color: var(--tps-bg, #ffffff);
    padding-top: var(--home-section-gap, var(--tps-padding-top, 50px));
    padding-bottom: var(--home-section-gap, var(--tps-padding-bottom, 50px));
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
  }

  .tps-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
    position: relative;
  }

  /* Centered Header */
  .tps-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 36px auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tps-title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: 36px;
    font-weight: 600;
    color: #232247;
    line-height: 1.25;
    margin: 0 0 10px 0;
    letter-spacing: -0.3px;
    text-align: center;
  }

  .tps-subtitle {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: 14.5px;
    line-height: 1.6;
    color: #555879;
    margin: 0;
    max-width: 680px;
    font-weight: 400;
    text-align: center;
  }

  .tps-divider {
    display: block;
    margin: 16px auto 0 auto;
    width: 72px;
    height: 2px;
    border-radius: 2px;
    background: #d4af37;
  }

  /* Carousel Wrapper */
  .tps-carousel-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  /* Navigation Arrow Buttons */
  .tps-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1e293b;
    cursor: pointer;
    z-index: 10;
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    outline: none;
  }

  .tps-nav-btn svg {
    width: 18px;
    height: 18px;
  }

  .tps-nav-btn:hover {
    background-color: #0a2e5c;
    color: #ffffff;
    border-color: #0a2e5c;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 8px 24px rgba(10, 46, 92, 0.28);
  }

  .tps-nav-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .tps-nav-btn--prev {
    left: -20px;
  }

  .tps-nav-btn--next {
    right: -20px;
  }

  /* Viewport (Hides Overflow cleanly) */
  .tps-viewport {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 10px 0 20px 0;
  }

  /* Track with Hardware-Accelerated Smooth Translation */
  .tps-track {
    display: flex;
    --tps-visible: 5;
    --tps-gap: 18px;
    gap: var(--tps-gap);
    width: 100%;
    box-sizing: border-box;
    will-change: transform;
    user-select: none;
  }

  /* Slide: Sized so exactly 5 cards show on wide desktop */
  .tps-slide {
    flex: 0 0 calc((100% - (var(--tps-visible) - 1) * var(--tps-gap)) / var(--tps-visible));
    width: calc((100% - (var(--tps-visible) - 1) * var(--tps-gap)) / var(--tps-visible));
    min-width: 0;
    box-sizing: border-box;
  }

  /* Card */
  .tps-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    outline: none;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background-color: #f1f5f9;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.35s ease;
  }

  .tps-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 34px rgba(10, 46, 92, 0.16);
  }

  /* Card Media (Portrait Aspect Ratio) */
  .tps-card-media {
    width: 100%;
    aspect-ratio: 3 / 4;
    position: relative;
    overflow: hidden;
    background-color: #e2e8f0;
  }

  .tps-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .tps-card:hover .tps-card-img {
    transform: scale(1.08);
  }

  .tps-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(12, 10, 25, 0.6) 0%, rgba(12, 10, 25, 0.1) 45%, transparent 100%);
    pointer-events: none;
  }

  /* Floating Bottom White Pill Badge (Exact Reference Match) */
  .tps-badge-pill {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: #ffffff;
    border-radius: 8px;
    padding: 9px 10px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    z-index: 2;
    transition: box-shadow 0.25s ease;
  }

  .tps-card:hover .tps-badge-pill {
    box-shadow: 0 6px 18px rgba(212, 175, 55, 0.4);
  }

  .tps-price-text {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: 0.2px;
    line-height: 1.2;
    white-space: nowrap;
    text-align: center;
  }

  .tps-category-text {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: 10px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.4px;
    line-height: 1.1;
    white-space: nowrap;
    text-align: center;
    text-transform: uppercase;
  }

  .tps-card:hover .tps-price-text {
    color: #0a2e5c;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1100px) {
    .tps-track {
      --tps-visible: 4;
      --tps-gap: 16px;
    }
    .tps-nav-btn--prev { left: -14px; }
    .tps-nav-btn--next { right: -14px; }
  }

  @media (max-width: 860px) {
    .tps-track {
      --tps-visible: 3;
      --tps-gap: 14px;
    }
    .tps-title {
      font-size: 30px;
    }
    .tps-nav-btn {
      width: 38px;
      height: 38px;
    }
  }

  @media (max-width: 640px) {
    .travel-price-showcase-section {
      padding-top: 36px;
      padding-bottom: 40px;
    }

    .tps-container {
      padding: 0 16px;
    }

    .tps-title {
      font-size: 26px;
    }

    .tps-subtitle {
      font-size: 13.5px;
    }

    .tps-track {
      --tps-visible: 2;
      --tps-gap: 12px;
    }

    .tps-badge-pill {
      bottom: 8px;
      left: 8px;
      right: 8px;
      padding: 7px 6px;
    }

    .tps-price-text {
      font-size: 12.5px;
    }

    .tps-category-text {
      font-size: 9px;
    }

    .tps-nav-btn {
      display: none;
    }
  }
</style>

<script>
  (function() {
    function initPriceSlider() {
      const section = document.getElementById('TravelPriceShowcase-{{ section.id }}');
      if (!section) return;

      const viewport = section.querySelector('.tps-viewport');
      const track = section.querySelector('.tps-track');
      const prevBtn = section.querySelector('.tps-nav-btn--prev');
      const nextBtn = section.querySelector('.tps-nav-btn--next');

      if (!viewport || !track) return;

      let isAnimating = false;
      let autoSlideTimer = null;
      let isHovered = false;

      function getStep() {
        const firstSlide = track.firstElementChild;
        if (!firstSlide) return 220;
        const slideWidth = firstSlide.getBoundingClientRect().width;
        const gap = parseFloat(getComputedStyle(track).gap) || 18;
        return slideWidth + gap;
      }

      function slideNext() {
        if (isAnimating || !track.firstElementChild) return;
        isAnimating = true;
        const step = getStep();

        let done = false;
        let fallbackTimer = null;

        const onEnd = function(e) {
          if (done) return;
          if (e && e.target !== track) return;
          done = true;
          if (fallbackTimer) clearTimeout(fallbackTimer);
          track.removeEventListener('transitionend', onEnd);
          track.style.transition = 'none';
          track.appendChild(track.firstElementChild);
          track.style.transform = 'translateX(0)';
          void track.offsetWidth;
          isAnimating = false;
        };

        track.addEventListener('transitionend', onEnd);
        fallbackTimer = setTimeout(onEnd, 550);

        track.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
        track.style.transform = 'translateX(-' + step + 'px)';
      }

      function slidePrev() {
        if (isAnimating || !track.lastElementChild) return;
        isAnimating = true;
        const step = getStep();

        track.style.transition = 'none';
        track.prepend(track.lastElementChild);
        track.style.transform = 'translateX(-' + step + 'px)';
        void track.offsetWidth;

        let done = false;
        let fallbackTimer = null;

        const onEnd = function(e) {
          if (done) return;
          if (e && e.target !== track) return;
          done = true;
          if (fallbackTimer) clearTimeout(fallbackTimer);
          track.removeEventListener('transitionend', onEnd);
          track.style.transition = 'none';
          isAnimating = false;
        };

        track.addEventListener('transitionend', onEnd);
        fallbackTimer = setTimeout(onEnd, 550);

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            track.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
            track.style.transform = 'translateX(0)';
          });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          slideNext();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          slidePrev();
        });
      }

      // Auto-slide every 3.5s
      function startAuto() {
        stopAuto();
        autoSlideTimer = setInterval(() => {
          if (!isHovered && !isAnimating) {
            slideNext();
          }
        }, 3500);
      }

      function stopAuto() {
        if (autoSlideTimer) {
          clearInterval(autoSlideTimer);
          autoSlideTimer = null;
        }
      }

      viewport.addEventListener('mouseenter', () => { isHovered = true; });
      viewport.addEventListener('mouseleave', () => { isHovered = false; });

      // Touch swipe support (Mobile)
      let touchStartX = 0;
      viewport.addEventListener('touchstart', (e) => {
        isHovered = true;
        touchStartX = e.touches[0].clientX;
      }, { passive: true });

      viewport.addEventListener('touchend', (e) => {
        const diffX = e.changedTouches[0].clientX - touchStartX;
        if (diffX < -40) {
          slideNext();
        } else if (diffX > 40) {
          slidePrev();
        }
        setTimeout(() => { isHovered = false; }, 1500);
      });

      startAuto();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPriceSlider);
    } else {
      initPriceSlider();
    }
  })();
</script>

{% schema %}
{
  "name": "Shop By Price",
  "tag": "section",
  "class": "section-travel-price-showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Price"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Handpicked boutique hotels, beachfront resorts & ultra-luxury private villas for every budget."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Gold Divider",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 55
    }
  ],
  "blocks": [
    {
      "type": "price_card",
      "name": "Price Card",
      "settings": [
        {
          "type": "text",
          "id": "price_badge",
          "label": "Price Tag Badge",
          "default": "5K - 10K"
        },
        {
          "type": "text",
          "id": "category_label",
          "label": "Category Label (e.g. Boutique Hotel)",
          "default": "Boutique Hotel"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Alt Title",
          "default": "Luxury Hotel"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback Asset Name",
          "default": "tour-bali.jpg"
        },
        {
          "type": "text",
          "id": "external_image_url",
          "label": "External Image URL (Unsplash or CDN)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Card Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Price",
      "blocks": [
        { "type": "price_card", "settings": { "price_badge": "5K - 10K", "category_label": "Boutique Hotel", "fallback_image": "tour-bali.jpg", "external_image_url": "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80" } },
        { "type": "price_card", "settings": { "price_badge": "10K - 20K", "category_label": "Hilltop Resort", "fallback_image": "tour-thailand.jpg", "external_image_url": "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80" } },

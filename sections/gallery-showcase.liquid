{% comment %}
  Gallery Image Showcase Section
  Tour & Travel Wings - Single Horizontal Row with Consistent Height
{% endcomment %}

{{ 'gallery-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gallery-showcase.js' | asset_url }}" defer="defer"></script>

<section
  id="gallery-showcase-{{ section.id }}"
  class="gallery-showcase-section"
  data-section-id="{{ section.id }}"
  data-drag="{{ section.settings.enable_drag }}"
  data-autoplay="{{ section.settings.enable_infinite_autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  data-lightbox="{{ section.settings.enable_lightbox }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --gsc-height-desktop: {{ section.settings.image_height_desktop }}px;
    --gsc-height-mobile: {{ section.settings.image_height_mobile }}px;
    --gsc-border-radius: {{ section.settings.image_border_radius }}px;
    --gsc-gap: {{ section.settings.gap_desktop }}px;
    --gsc-gap-mobile: {{ section.settings.gap_mobile }}px;
    --gsc-aspect-ratio: {{ section.settings.image_aspect_ratio }};
  "
>
  <div class="gallery-showcase-container {% if section.settings.full_width %}is-full-width{% else %}is-page-width{% endif %}">
    
    <!-- Section Header Row -->
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="gallery-showcase-header text-{{ section.settings.heading_alignment }}">
        <div class="gallery-showcase-header-row">
          <div class="gallery-showcase-header-content">
            {%- if section.settings.subheading != blank -%}
              <span class="gallery-showcase-kicker">{{ section.settings.subheading }}</span>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="gallery-showcase-heading">{{ section.settings.heading }}</h2>
            {%- endif -%}

            {%- if section.settings.description != blank -%}
              <p class="gallery-showcase-description">{{ section.settings.description }}</p>
            {%- endif -%}
          </div>

          <!-- Top Navigation Controls -->
          {%- if section.settings.enable_arrows and section.blocks.size > 1 -%}
            <div class="gallery-showcase-controls-top" aria-hidden="true">
              <button
                type="button"
                class="gallery-showcase-nav-btn gallery-showcase-prev-btn"
                aria-label="Previous image"
              >
                <svg viewBox="0 0 24 24">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button
                type="button"
                class="gallery-showcase-nav-btn gallery-showcase-next-btn"
                aria-label="Next image"
              >
                <svg viewBox="0 0 24 24">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Horizontal Showcase Track (Consistent Height Row) -->
    <div class="gallery-showcase-track-wrapper">
      <div
        class="gallery-showcase-track"
        tabindex="0"
        role="region"
        aria-label="Image gallery showcase"
      >
        {%- for block in section.blocks -%}
          {%- assign item_image = block.settings.image -%}
          {%- assign fallback_img = block.settings.fallback_image | default: 'hero-santorini.jpg' -%}
          {%- if item_image != blank -%}
            {%- assign img_url = item_image | image_url: width: 1400 -%}
            {%- assign full_url = item_image | image_url: width: 2200 -%}
          {%- else -%}
            {%- assign img_url = fallback_img | asset_url -%}
            {%- assign full_url = fallback_img | asset_url -%}
          {%- endif -%}

          <div
            id="gallery-card-{{ block.id }}"
            class="gallery-showcase-card"
            data-block-id="{{ block.id }}"
            data-full-image="{{ full_url }}"
            data-title="{{ block.settings.title | escape }}"
            data-desc="{{ block.settings.caption | escape }}"
            {{ block.shopify_attributes }}
          >
            <!-- Card Image -->
            <img
              src="{{ img_url }}"
              alt="{{ block.settings.title | default: 'Travel gallery destination' | escape }}"
              class="gallery-showcase-img"
              width="600"
              height="400"
              loading="lazy"
              draggable="false"
            >

            <!-- Dark Gradient Overlay -->
            <div class="gallery-showcase-overlay" aria-hidden="true"></div>

            <!-- Zoom Lightbox Button -->
            {%- if section.settings.enable_lightbox -%}
              <button
                type="button"
                class="gallery-showcase-zoom-btn"
                aria-label="Enlarge image: {{ block.settings.title | escape }}"
              >
                <svg viewBox="0 0 24 24">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </button>
            {%- endif -%}

            <!-- Optional Destination Link -->
            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="gallery-showcase-card-link"
                aria-label="View {{ block.settings.title | escape }}"
              ></a>
            {%- endif -%}

            <!-- Caption Overlay -->
            {%- if section.settings.show_caption_overlay and block.settings.title != blank -%}
              <div class="gallery-showcase-caption">
                {%- if block.settings.kicker != blank -%}
                  <span class="gallery-showcase-card-kicker">{{ block.settings.kicker }}</span>
                {%- endif -%}
                <h3 class="gallery-showcase-card-title">{{ block.settings.title }}</h3>
                {%- if block.settings.caption != blank -%}
                  <p class="gallery-showcase-card-text">{{ block.settings.caption }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Progress Indicator Bar -->
    {%- if section.settings.show_progress_bar and section.blocks.size > 2 -%}
      <div class="gallery-showcase-progress-wrap" aria-hidden="true">
        <div class="gallery-showcase-progress-bar">
          <div class="gallery-showcase-progress-fill"></div>
        </div>
      </div>
    {%- endif -%}

  </div>

  <!-- Interactive Lightbox Modal -->
  {%- if section.settings.enable_lightbox -%}
    <div
      class="gallery-lightbox-modal"
      role="dialog"
      aria-modal="true"
      aria-label="Enlarged photo preview"
    >
      <button
        type="button"
        class="gallery-lightbox-prev-btn"
        aria-label="Previous photo"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        type="button"
        class="gallery-lightbox-next-btn"
        aria-label="Next photo"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="gallery-lightbox-container">
        <button
          type="button"
          class="gallery-lightbox-close-btn"
          aria-label="Close photo preview"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <div class="gallery-lightbox-img-wrap">
          <img
            src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
            alt="Preview modal"
            class="gallery-lightbox-img"
            width="1200"
            height="800"
          >
        </div>

        <div class="gallery-lightbox-caption">
          <h4 class="gallery-lightbox-title"></h4>
          <p class="gallery-lightbox-desc"></p>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Gallery Showcase",
  "tag": "section",
  "class": "section-gallery-showcase",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Kicker / Subheading",
      "default": "EXPLORE • DISCOVER • CAPTURE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Moments Beyond Destinations"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A visual showcase of unforgettable travel highlights and breathtaking locations from around the globe."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Row Dimensions & Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width row",
      "default": false
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Consistent image height (desktop)",
      "min": 240,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Consistent image height (mobile)",
      "min": 180,
      "max": 380,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Card Proportion",
      "options": [
        {
          "value": "4 / 3",
          "label": "Standard Landscape (4:3)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Gap between images (desktop)",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between images (mobile)",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Interactive Features"
    },
    {
      "type": "checkbox",
      "id": "show_caption_overlay",
      "label": "Show destination caption overlay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Enable photo zoom / lightbox modal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_drag",
      "label": "Enable mouse drag-to-scroll on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Show horizontal scroll progress bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_autoplay",
      "label": "Enable auto-scroll",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-scroll interval (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback Asset Name",
          "default": "hero-santorini.jpg"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Tag / Category",
          "default": "GREECE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Destination Title",
          "default": "Santorini, Greece"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption / Short Description",
          "default": "Iconic blue domes overlooking the deep Aegean caldera."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery Image Showcase",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "fallback_image": "hero-santorini.jpg",
            "kicker": "GREECE",
            "title": "Santorini Caldera",
            "caption": "Iconic cobalt blue domes overlooking the deep Aegean sea."
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "tour-bali.jpg",
            "kicker": "INDONESIA",
            "title": "Bali Island Haven",
            "caption": "Lush tropical terraces, volcanic peaks, and serene beach temples."
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "tour-swiss-alps.jpg",
            "kicker": "SWITZERLAND",
            "title": "Swiss Alpine Peaks",
            "caption": "Majestic snow-dusted summits, alpine meadows, and wooden chalets."
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "hero-maldives.jpg",
            "kicker": "MALDIVES",
            "title": "Overwater Luxury",
            "caption": "Private turquoise lagoons and pure powdery coral sand beaches."
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "tour-dubai.jpg",
            "kicker": "UAE",
            "title": "Dubai Oasis & Skyline",
            "caption": "Golden desert dune safaris meeting futuristic architectural wonder."
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "tour-thailand.jpg",
            "kicker": "THAILAND",
            "title": "Phuket & Krabi Bays",
            "caption": "Limestone karst islands rising from emerald waters."
          }
        }
      ]
    }
  ]
}
{% endschema %}


{%- comment -%}
  Journal Accordion Section
{%- endcomment -%}

{{ 'journal-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'journal-accordion.js' | asset_url }}" defer="defer"></script>

<div class="journal-accordion-section" id="JournalAccordion-{{ section.id }}">
  <div class="journal-accordion-outer">
    <div class="journal-header">
      {%- if section.settings.title != blank -%}
        <h2 class="journal-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="journal-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="journal-accordion-wrapper">
      {%- for block in section.blocks -%}
        <div class="journal-item" {{ block.shopify_attributes }}>
          
          <div class="journal-item-bg">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
            {%- elsif block.settings.fallback_image != blank -%}
              <img src="{{ block.settings.fallback_image | asset_url }}" loading="lazy" alt="{{ block.settings.title }}" width="1200" height="800">
            {%- else -%}
              {%- assign down_j = block.settings.title | append: ' ' | append: block.settings.desc | downcase -%}
              {%- if down_j contains 'ellora' or down_j contains 'kailasa' -%}
                {%- assign j_fallback = 'india-ellora.jpg' -%}
              {%- elsif down_j contains 'konark' or down_j contains 'odisha' -%}
                {%- assign j_fallback = 'india-konark.jpg' -%}
              {%- elsif down_j contains 'valley of flowers' or down_j contains 'uttarakhand' -%}
                {%- assign j_fallback = 'india-valley-of-flowers.jpg' -%}
              {%- elsif down_j contains 'coorg' or down_j contains 'kodagu' or down_j contains 'abbey' -%}
                {%- assign j_fallback = 'india-coorg.jpg' -%}
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}{%- assign j_fallback = 'india-ellora.jpg' -%}
                  {%- when 2 -%}{%- assign j_fallback = 'india-konark.jpg' -%}
                  {%- when 3 -%}{%- assign j_fallback = 'india-valley-of-flowers.jpg' -%}
                  {%- when 4 -%}{%- assign j_fallback = 'india-coorg.jpg' -%}
                  {%- else -%}{%- assign j_fallback = 'india-ellora.jpg' -%}
                {%- endcase -%}
              {%- endif -%}
              <img src="{{ j_fallback | asset_url }}" loading="lazy" alt="{{ block.settings.title }}" width="1200" height="800">
            {%- endif -%}
          </div>
            
            <div class="journal-item-overlay"></div>
            
            <div class="journal-item-content">
              {%- if block.settings.subtitle != blank -%}
                <div class="journal-item-subtitle">{{ block.settings.subtitle }}</div>
              {%- endif -%}
              
              {%- if block.settings.title != blank -%}
                <h3 class="journal-item-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              
              {%- if block.settings.desc != blank -%}
                <p class="journal-item-desc">{{ block.settings.desc }}</p>
              {%- endif -%}
              
              {%- if block.settings.link_text != blank -%}
                <a href="{{ block.settings.link | default: '#' }}" class="journal-item-link">
                  {{ block.settings.link_text }}
                  <svg viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
                </a>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

{% schema %}
{
  "name": "Journal Accordion",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Experience Luxury & Comfort"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Inspiring Indian travel stories, heritage guides, and insider tips from our explorers across India."
    }
  ],
  "blocks": [
    {
      "type": "journal_entry",
      "name": "Journal Entry",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback Asset Image Filename"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Heritage Guide • 5 Min Read"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kailasa Temple of Ellora"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Carved top-down from a single basalt mountain cliff, explore Maharashtra's 8th-century rock-cut wonder and ancient cave sanctuaries."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Read the Story"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal Accordion",
      "blocks": [
        {
          "type": "journal_entry",
          "settings": {
            "fallback_image": "india-ellora.jpg",
            "subtitle": "Heritage Guide • 5 Min Read",
            "title": "Kailasa Temple of Ellora",
            "desc": "Carved top-down from a single basalt mountain cliff, explore Maharashtra's 8th-century rock-cut wonder and ancient cave sanctuaries.",
            "link_text": "Read the Story"
          }
        },
        {
          "type": "journal_entry",
          "settings": {
            "fallback_image": "india-konark.jpg",
            "subtitle": "Architectural Marvel • 4 Min Read",
            "title": "The Sun Chariot of Konark",
            "desc": "Discover Odisha's 13th-century UNESCO temple shaped like Surya's colossal stone chariot, adorned with intricately carved wheels and sculptures.",
            "link_text": "Read the Story"
          }
        },
        {
          "type": "journal_entry",
          "settings": {
            "fallback_image": "india-valley-of-flowers.jpg",
            "subtitle": "Himalayan Trek • 6 Min Read",
            "title": "Uttarakhand's Valley of Flowers",
            "desc": "Trek through mist-veiled Garhwal alpine meadows, glacial streams, and rare Himalayan wildflowers beneath towering snow peaks.",
            "link_text": "Read the Story"
          }
        },
        {
          "type": "journal_entry",
          "settings": {
            "fallback_image": "india-coorg.jpg",
            "subtitle": "Nature Retreat • 4 Min Read",
            "title": "Misty Coffee Trails of Coorg",
            "desc": "Wake up to aromatic spice estates, cascading Abbey Falls, and emerald rainforest hills in Karnataka's timeless Scotland of India.",
            "link_text": "Read the Story"
          }
        }
      ]
    }
  ]
}
{% endschema %}

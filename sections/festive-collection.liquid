{{ 'festive-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'festive-collection.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection_blocks = section.blocks | where: 'type', 'collection_card'
-%}

<div 
  id="FestiveCollection-{{ section.id }}" 
  class="festive-collection-section"
  data-section-type="festive-collection"
  data-show-hover="{{ section.settings.show_hover_text }}"
  style="--fc-bg-color: {{ section.settings.background_color | default: '#ffffff' }};"
>
  <div class="fc-container">
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <div class="fc-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title fc-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subtitle != blank -%}
          <p class="section-subtitle fc-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection_blocks.size > 0 -%}
      <div class="fc-grid" style="--desktop-cols: {{ section.settings.desktop_columns }}; --mobile-cols: {{ section.settings.mobile_columns }};">
        {%- for block in collection_blocks -%}
          {%- liquid
            assign target_collection = block.settings.collection
            assign tag_text = block.settings.tag_text | default: 'POPULAR'
            assign title_text = block.settings.title | default: target_collection.title | default: 'India'
            assign subtitle_text = block.settings.subtitle | default: 'Handcrafted Getaway'
            assign button_text = block.settings.button_text | default: 'Explore'
            assign card_url = block.settings.url | default: target_collection.url | default: routes.all_products_collection_url
            
            assign card_image = null
            if block.settings.image != blank
              assign card_image = block.settings.image
            elsif target_collection != blank and target_collection.featured_image != blank
              assign card_image = target_collection.featured_image
            endif

            assign down_title = title_text | downcase
            assign default_asset_img = ''
            if down_title contains 'agra' or down_title contains 'taj'
              assign default_asset_img = 'india-agra.jpg'
            elsif down_title contains 'udaipur'
              assign default_asset_img = 'india-udaipur.jpg'
            elsif down_title contains 'manali' or down_title contains 'himachal'
              assign default_asset_img = 'india-manali.jpg'
            elsif down_title contains 'varanasi' or down_title contains 'kashi'
              assign default_asset_img = 'india-varanasi.jpg'
            elsif down_title contains 'darjeeling' or down_title contains 'sikkim'
              assign default_asset_img = 'india-darjeeling.jpg'
            elsif down_title contains 'andaman' or down_title contains 'havelock'
              assign default_asset_img = 'india-andaman.jpg'
            elsif down_title contains 'kashmir'
              assign default_asset_img = 'india-kashmir.jpg'
            elsif down_title contains 'kerala'
              assign default_asset_img = 'india-kerala.jpg'
            elsif down_title contains 'jaipur'
              assign default_asset_img = 'india-jaipur.jpg'
            elsif down_title contains 'ladakh'
              assign default_asset_img = 'india-ladakh.jpg'
            elsif down_title contains 'goa'
              assign default_asset_img = 'india-goa.jpg'
            else
              case forloop.index
                when 1
                  assign default_asset_img = 'india-agra.jpg'
                when 2
                  assign default_asset_img = 'india-udaipur.jpg'
                when 3
                  assign default_asset_img = 'india-manali.jpg'
                when 4
                  assign default_asset_img = 'india-varanasi.jpg'
                when 5
                  assign default_asset_img = 'india-darjeeling.jpg'
                when 6
                  assign default_asset_img = 'india-andaman.jpg'
                else
                  assign default_asset_img = 'india-agra.jpg'
              endcase
            endif
          -%}

          <a href="{{ card_url }}" class="fc-card" {{ block.shopify_attributes }}>
            <div class="fc-image-wrapper">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 800 | image_tag: class: 'fc-image', loading: 'lazy', alt: title_text }}
              {%- elsif block.settings.fallback_image != blank -%}
                <img class="fc-image" loading="lazy" src="{{ block.settings.fallback_image | asset_url }}" alt="{{ title_text }}" width="800" height="1000">
              {%- else -%}
                <img class="fc-image" loading="lazy" src="{{ default_asset_img | asset_url }}" alt="{{ title_text }}" width="800" height="1000">
              {%- endif -%}
            </div>

            <!-- Exact Figma Fading Horizontal Glass Banner Bar -->
            <div class="fc-glass-bar">
              {%- if tag_text != blank -%}
                <div class="fc-bar-tag">{{ tag_text }}</div>
              {%- endif -%}
              <h3 class="fc-bar-title">{{ title_text }}</h3>
              {%- if subtitle_text != blank -%}
                <div class="fc-bar-subtitle">{{ subtitle_text }}</div>
              {%- endif -%}
            </div>

            <!-- Lower Position Hover State (Card 2 Design) -->
            {%- if section.settings.show_hover_text -%}
              <div class="fc-hover-overlay">
                {%- if tag_text != blank -%}
                  <div class="fc-hover-tag">{{ tag_text }}</div>
                {%- endif -%}
                <h3 class="fc-hover-title">{{ title_text }}</h3>
                {%- if subtitle_text != blank -%}
                  <div class="fc-hover-subtitle">{{ subtitle_text }}</div>
                {%- endif -%}
                
                <div class="fc-shop-button">
                  <span>{{ button_text }}</span>
                  <div class="fc-shop-button-icon">
                    <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Festive Collection",
  "class": "section-festive-collection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_hover_text",
      "label": "Show Hover Text and Button",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Mobile Columns",
      "default": 3
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Title",
      "default": "India’s Finest Destinations"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Line",
      "default": "Discover majestic Himalayas, royal palaces, sacred rivers, lush hills, and turquoise islands — handcrafted holiday getaways across India."
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card Box",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Overrides collection image)"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback Asset Image Filename"
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Sub-tag Text",
          "default": "POPULAR"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Main Title",
          "default": "Agra"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Card Subtitle",
          "default": "Taj Mahal & Mughal Heritage"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Hover Button Text",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Link URL",
          "info": "Leave blank to use Shopify Collection URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Festive Collection Grid",
      "settings": {
        "heading": "India’s Finest Destinations",
        "subtitle": "Discover majestic Himalayas, royal palaces, sacred rivers, lush hills, and turquoise islands — handcrafted holiday getaways across India."
      },
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "fallback_image": "india-agra.jpg",
            "tag_text": "ICONIC WONDER",
            "title": "Agra",
            "subtitle": "Taj Mahal & Mughal Heritage",
            "button_text": "Explore"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "fallback_image": "india-udaipur.jpg",
            "tag_text": "ROYAL LUXURY",
            "title": "Udaipur",
            "subtitle": "City of Lakes & Palaces",
            "button_text": "Explore"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "fallback_image": "india-manali.jpg",
            "tag_text": "HIMALAYAN ESCAPE",
            "title": "Manali",
            "subtitle": "Snow Peaks & Pine Valleys",
            "button_text": "Explore"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "fallback_image": "india-varanasi.jpg",
            "tag_text": "SPIRITUAL SOUL",
            "title": "Varanasi",
            "subtitle": "Sacred Ghats & Eternal Ganga",
            "button_text": "Explore"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "fallback_image": "india-darjeeling.jpg",
            "tag_text": "SCENIC HILLS",
            "title": "Darjeeling",
            "subtitle": "Tea Gardens & Kanchenjunga",
            "button_text": "Explore"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "fallback_image": "india-andaman.jpg",
            "tag_text": "ISLAND PARADISE",
            "title": "Andaman",
            "subtitle": "Turquoise Lagoons & Coral Reefs",
            "button_text": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}

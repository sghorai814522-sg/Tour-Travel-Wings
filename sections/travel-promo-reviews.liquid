{% comment %}
  Travel Promo Banner & Bento Masonry Customer Reviews
  Tour & Travel Wings
  Features:
  - Promotional Banner with CTA
  - Centered Header with Title, Subtitle, and Gold Divider
  - 3-Column Bento / Masonry Review Grid matching reference design:
    * Col 1: Pastel Text Card (top) + Tour Image Card (bottom)
    * Col 2: Tall Featured Tour Image Card (center)
    * Col 3: Tour Image Card (top) + Pastel Text Card (bottom)
  - 100% Tour-related images & authentic feedback
  - Mobile touch-swipe carousel
{% endcomment %}

{{ 'travel-promo-reviews.css' | asset_url | stylesheet_tag }}

<div
  id="travel-promo-reviews-{{ section.id }}"
  class="travel-promo-reviews-section"
  data-section-id="{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  "
>
  <div class="travel-promo-reviews-container">

    <!-- 1. Promotional Mountain Banner -->
    {%- if section.settings.show_banner -%}
      {%- assign banner_bg = section.settings.banner_image -%}
      {%- assign fallback_bg = section.settings.banner_fallback_image | default: 'india-manali.jpg' -%}
      {%- if banner_bg != blank -%}
        {%- assign banner_url = banner_bg | image_url: width: 2400 -%}
      {%- else -%}
        {%- assign banner_url = fallback_bg | asset_url -%}
      {%- endif -%}

      <div class="travel-promo-banner-wrap">
        <div
          class="travel-promo-banner"
          style="background-image: url('{{ banner_url }}');"
        >
          <!-- Dark Overlay -->
          <div class="travel-promo-banner-overlay"></div>

          <!-- Banner Content -->
          <div class="travel-promo-banner-content">
            {%- if section.settings.banner_badge != blank -%}
              <span class="travel-promo-badge">{{ section.settings.banner_badge }}</span>
            {%- endif -%}

            {%- if section.settings.banner_heading != blank -%}
              <h2 class="travel-promo-heading">{{ section.settings.banner_heading }}</h2>
            {%- endif -%}

            {%- if section.settings.banner_subheading != blank -%}
              <p class="travel-promo-subheading">{{ section.settings.banner_subheading }}</p>
            {%- endif -%}
          </div>

          <!-- Action Button -->
          {%- if section.settings.banner_button_text != blank -%}
            <div class="travel-promo-btn-wrap">
              <a
                href="{{ section.settings.banner_button_link | default: '#' }}"
                class="travel-promo-btn"
              >
                {{ section.settings.banner_button_text }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <!-- 2. Customer Reviews Section Header (Centered) -->
    {%- if section.settings.reviews_title != blank -%}
      <div class="travel-reviews-header">
        <h2 class="travel-reviews-title">{{ section.settings.reviews_title }}</h2>
        {%- if section.settings.reviews_subtitle != blank -%}
          <p class="travel-reviews-subtitle">{{ section.settings.reviews_subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.show_divider -%}
          <div class="travel-reviews-divider"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- 3. Bento Masonry Reviews Grid (Exact Reference Match) -->
    {%- assign bento_blocks = section.blocks | where: 'type', 'bento_review' -%}

    {%- if bento_blocks.size >= 5 -%}
      <!-- Dynamic Blocks Render -->
      <div class="travel-bento-reviews-grid">
        <!-- Column 1 (Left) -->
        <div class="travel-bento-col travel-bento-col--left">
          {%- render 'bento-review-card', block: bento_blocks[0], default_type: 'pastel' -%}
          {%- render 'bento-review-card', block: bento_blocks[1], default_type: 'image' -%}
        </div>

        <!-- Column 2 (Center - Tall) -->
        <div class="travel-bento-col travel-bento-col--center">
          {%- render 'bento-review-card', block: bento_blocks[2], default_type: 'tall_image' -%}
        </div>

        <!-- Column 3 (Right) -->
        <div class="travel-bento-col travel-bento-col--right">
          {%- render 'bento-review-card', block: bento_blocks[3], default_type: 'image' -%}
          {%- render 'bento-review-card', block: bento_blocks[4], default_type: 'pastel' -%}
        </div>
      </div>

    {%- else -%}
      <!-- Fallback / Default 5 Bento Cards with Tour Images & Authentic Reviews -->
      <div class="travel-bento-reviews-grid">
        <!-- Column 1 (Left) -->
        <div class="travel-bento-col travel-bento-col--left">
          <!-- Card 1: Pastel Text Card -->
          <div class="travel-bento-card travel-bento-card--pastel" style="background-color: #fce7f3;">
            <p class="travel-bento-text">
              Our Kashmir holiday was pure magic. Gliding on Dal Lake in a Shikara at sunrise and the snow-capped gondola ride in Gulmarg exceeded every dream! <a href="#" class="travel-bento-readmore">... Read More</a>
            </p>
            <div class="travel-bento-footer">
              <div class="travel-bento-author-meta">
                <span class="travel-bento-author-name">Aarav Sharma</span>
                <span class="travel-bento-date">12 November 2025</span>
              </div>
              <div class="travel-bento-stars" aria-label="5 stars">★★★★★</div>
            </div>
          </div>

          <!-- Card 2: Image Card (Kerala) -->
          <div class="travel-bento-card travel-bento-card--image">
            <img src="{{ 'india-kerala.jpg' | asset_url }}" alt="Kerala Luxury Houseboat Tour Review" class="travel-bento-img" loading="lazy" width="600" height="400">
            <div class="travel-bento-overlay"></div>
            <div class="travel-bento-overlay-content">
              <p class="travel-bento-text">
                Drifting through Alleppey backwaters on a private luxury houseboat with authentic Kerala delicacies was pure bliss. Unforgettable hospitality! <a href="#" class="travel-bento-readmore">... Read More</a>
              </p>
              <div class="travel-bento-footer">
                <div class="travel-bento-author-meta">
                  <span class="travel-bento-author-name">Priya Nair</span>
                  <span class="travel-bento-date">8 November 2025</span>
                </div>
                <div class="travel-bento-stars" aria-label="5 stars">★★★★★</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Column 2 (Center - Tall Featured Image Card) -->
        <div class="travel-bento-col travel-bento-col--center">
          <!-- Card 3: Tall Image Card (Jaipur / Royal Rajasthan) -->
          <div class="travel-bento-card travel-bento-card--image travel-bento-card--tall">
            <img src="{{ 'india-jaipur.jpg' | asset_url }}" alt="Royal Rajasthan Luxury Tour Review" class="travel-bento-img" loading="lazy" width="600" height="800">
            <div class="travel-bento-overlay"></div>
            <div class="travel-bento-overlay-content">
              <p class="travel-bento-text">
                Experiencing the grand palaces of Jaipur and royal heritage forts was breathtaking. Tour & Travel Wings treated us like royalty every single day! <a href="#" class="travel-bento-readmore">... Read More</a>
              </p>
              <div class="travel-bento-footer">
                <div class="travel-bento-author-meta">
                  <span class="travel-bento-author-name">Rohan Kapoor</span>
                  <span class="travel-bento-date">5 November 2025</span>
                </div>
                <div class="travel-bento-stars" aria-label="5 stars">★★★★★</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Column 3 (Right) -->
        <div class="travel-bento-col travel-bento-col--right">
          <!-- Card 4: Image Card (Goa) -->
          <div class="travel-bento-card travel-bento-card--image">
            <img src="{{ 'india-goa.jpg' | asset_url }}" alt="Goa Luxury Coastal Tour Review" class="travel-bento-img" loading="lazy" width="600" height="400">
            <div class="travel-bento-overlay"></div>
            <div class="travel-bento-overlay-content">
              <p class="travel-bento-text">
                Sunsets at Palolem Beach, private coastal cruising, and heritage Portuguese boutique stays in Goa made our vacation sheer perfection! <a href="#" class="travel-bento-readmore">... Read More</a>
              </p>
              <div class="travel-bento-footer">
                <div class="travel-bento-author-meta">
                  <span class="travel-bento-author-name">Sneha Patel</span>
                  <span class="travel-bento-date">2 November 2025</span>
                </div>
                <div class="travel-bento-stars" aria-label="5 stars">★★★★★</div>
              </div>
            </div>
          </div>

          <!-- Card 5: Pastel Text Card (Ladakh) -->
          <div class="travel-bento-card travel-bento-card--pastel" style="background-color: #fce7f3;">
            <p class="travel-bento-text">
              Crossing Khardung La pass and stargazing by the crystal azure waters of Pangong Lake in Ladakh was a soul-stirring adventure. Flawlessly organized! <a href="#" class="travel-bento-readmore">... Read More</a>
            </p>
            <div class="travel-bento-footer">
              <div class="travel-bento-author-meta">
                <span class="travel-bento-author-name">Vikramaditya Das</span>
                <span class="travel-bento-date">28 October 2025</span>
              </div>
              <div class="travel-bento-stars" aria-label="5 stars">★★★★★</div>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Promo Banner & Reviews",
  "tag": "section",
  "class": "section-travel-promo-reviews",
  "settings": [
    {
      "type": "header",
      "content": "Promotional Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show promotional banner",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "banner_fallback_image",
      "label": "Fallback Asset Name",
      "default": "india-manali.jpg"
    },
    {
      "type": "text",
      "id": "banner_badge",
      "label": "Badge Text",
      "default": "SPECIAL OFFER"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner Heading",
      "default": "Up to 20% Off on Selected Tours"
    },
    {
      "type": "text",
      "id": "banner_subheading",
      "label": "Banner Subheading",
      "default": "Explore more. Spend less. Make it happen."
    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Button Text",
      "default": "View Offers"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "reviews_title",
      "label": "Section Title",
      "default": "What Our Travelers Say"
    },
    {
      "type": "textarea",
      "id": "reviews_subtitle",
      "label": "Section Subtitle",
      "default": "Real stories, unforgettable journeys, and five-star memories from our adventurers."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Gold Divider",
      "default": true
    },
    {
      "type": "select",
      "id": "reviews_title_alignment",
      "label": "Title Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "bento_review",
      "name": "Bento Review Card",
      "settings": [
        {
          "type": "select",
          "id": "card_type",
          "label": "Card Type",
          "options": [
            { "value": "pastel", "label": "Pastel Text Card" },
            { "value": "image", "label": "Standard Image Card" },
            { "value": "tall_image", "label": "Tall Featured Image Card (Center)" }
          ],
          "default": "pastel"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Kanchan T."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "4 November 2025"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "The Swiss Alps tour exceeded every dream. Every chalet, scenic train ride, and mountain peak was planned to perfection."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tour Photo (for image cards)"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Theme Asset Image Filename",
          "default": "india-kerala.jpg"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Pastel Background Color",
          "default": "#fce7f3"
        }
      ]
    },
    {
      "type": "review",
      "name": "Legacy Review Card",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Kanchan T."
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "An incredible journey from start to finish!"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Banner & Reviews",
      "blocks": [
        {
          "type": "bento_review",
          "settings": {
            "card_type": "pastel",
            "reviewer_name": "Aarav Sharma",
            "date": "12 November 2025",
            "review_text": "Our Kashmir holiday was pure magic. Gliding on Dal Lake in a Shikara at sunrise and the snow-capped gondola ride in Gulmarg exceeded every dream!",
            "rating": 5
          }
        },
        {
          "type": "bento_review",
          "settings": {
            "card_type": "image",
            "fallback_image": "india-kerala.jpg",
            "reviewer_name": "Priya Nair",
            "date": "8 November 2025",
            "review_text": "Drifting through Alleppey backwaters on a private luxury houseboat with authentic Kerala delicacies was pure bliss. Unforgettable hospitality!",
            "rating": 5
          }
        },
        {
          "type": "bento_review",
          "settings": {
            "card_type": "tall_image",
            "fallback_image": "india-jaipur.jpg",
            "reviewer_name": "Rohan Kapoor",
            "date": "5 November 2025",
            "review_text": "Experiencing the grand palaces of Jaipur and royal heritage forts was breathtaking. Tour & Travel Wings treated us like royalty every single day!",
            "rating": 5
          }
        },
        {
          "type": "bento_review",
          "settings": {
            "card_type": "image",
            "fallback_image": "india-goa.jpg",
            "reviewer_name": "Sneha Patel",
            "date": "2 November 2025",
            "review_text": "Sunsets at Palolem Beach, private coastal cruising, and heritage Portuguese boutique stays in Goa made our vacation sheer perfection!",
            "rating": 5
          }
        },
        {
          "type": "bento_review",
          "settings": {
            "card_type": "pastel",
            "reviewer_name": "Vikramaditya Das",
            "date": "28 October 2025",
            "review_text": "Crossing Khardung La pass and stargazing by the crystal azure waters of Pangong Lake in Ladakh was a soul-stirring adventure. Flawlessly organized!",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}

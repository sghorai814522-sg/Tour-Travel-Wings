{% comment %}
  Travel Promo Banner & Customer Reviews
  Tour & Travel Wings
{% endcomment %}

{{ 'travel-promo-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'travel-promo-reviews.js' | asset_url }}" defer="defer"></script>

<div
  id="travel-promo-reviews-{{ section.id }}"
  class="travel-promo-reviews-section"
  data-section-id="{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --tpr-columns: {{ section.settings.reviews_columns_desktop }};
  "
>
  <div class="travel-promo-reviews-container">
    <!-- 1. Promotional Mountain Banner -->
    {%- if section.settings.show_banner -%}
      {%- assign banner_bg = section.settings.banner_image -%}
      {%- assign fallback_bg = section.settings.banner_fallback_image | default: 'promo-mountain-bg.jpg' -%}
      {%- if banner_bg != blank -%}
        {%- assign banner_url = banner_bg | image_url: width: 2400 -%}
      {%- else -%}
        {%- assign banner_url = fallback_bg | asset_url -%}
      {%- endif -%}

      <div class="travel-promo-banner-wrap">
        <div
          class="travel-promo-banner"
          style="background-image: url('{{ banner_url }}');"
        >
          <!-- Dark Overlay -->
          <div class="travel-promo-banner-overlay"></div>

          <!-- Banner Content (Left/Center) -->
          <div class="travel-promo-banner-content">
            {%- if section.settings.banner_badge != blank -%}
              <span class="travel-promo-badge">{{ section.settings.banner_badge }}</span>
            {%- endif -%}

            {%- if section.settings.banner_heading != blank -%}
              <h2 class="travel-promo-heading">{{ section.settings.banner_heading }}</h2>
            {%- endif -%}

            {%- if section.settings.banner_subheading != blank -%}
              <p class="travel-promo-subheading">{{ section.settings.banner_subheading }}</p>
            {%- endif -%}
          </div>

          <!-- Dynamic Action Button (Right) -->
          {%- if section.settings.banner_button_text != blank -%}
            <div class="travel-promo-btn-wrap">
              <a
                href="{{ section.settings.banner_button_link | default: routes.all_products_collection_url }}"
                class="travel-promo-btn"
              >
                {{ section.settings.banner_button_text }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <!-- 2. Customer Reviews Section -->
    {%- if section.settings.reviews_title != blank -%}
      <div
        class="travel-reviews-header"
        style="text-align: {{ section.settings.reviews_title_alignment }};"
      >
        <h2 class="travel-reviews-title">{{ section.settings.reviews_title }}</h2>
      </div>
    {%- endif -%}

    <!-- Reviews Grid / Mobile Slider -->
    {%- if section.blocks.size > 0 -%}
      <div class="travel-reviews-grid{% if section.settings.enable_slider_mobile %} is-slider-mobile{% endif %}">
        {%- for block in section.blocks -%}
          {%- assign avatar_img = block.settings.avatar -%}
          {%- assign fallback_av = block.settings.fallback_avatar | default: 'avatar-priya.jpg' -%}
          {%- if avatar_img != blank -%}
            {%- assign av_url = avatar_img | image_url: width: 120, height: 120 -%}
          {%- else -%}
            {%- assign av_url = fallback_av | asset_url -%}
          {%- endif -%}

          <div
            id="review-{{ block.id }}"
            class="travel-review-card"
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <!-- Review Text & Quote Icon -->
            <div class="travel-review-body">
              <div class="travel-review-quote-icon" aria-hidden="true">
                <!-- Double Quote SVG Icon -->
                <svg viewBox="0 0 24 24">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                </svg>
              </div>

              {%- if block.settings.review_text != blank -%}
                <p class="travel-review-quote-text">
                  &ldquo;{{ block.settings.review_text }}&rdquo;
                </p>
              {%- endif -%}
            </div>

            <!-- Reviewer Info Footer -->
            <div class="travel-reviewer-footer">
              <img
                src="{{ av_url }}"
                alt="{{ block.settings.reviewer_name | default: 'Traveler' }}"
                class="travel-reviewer-avatar"
                width="44"
                height="44"
                loading="lazy"
              >

              <div class="travel-reviewer-meta">
                {%- if block.settings.reviewer_name != blank -%}
                  <span class="travel-reviewer-name">{{ block.settings.reviewer_name }}</span>
                {%- endif -%}

                {%- if block.settings.reviewer_location != blank -%}
                  <span class="travel-reviewer-location">{{ block.settings.reviewer_location }}</span>
                {%- endif -%}

                <!-- Star Rating -->
                <div class="travel-reviewer-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {%- assign rating_num = block.settings.rating | default: 5 -%}
                  {%- for i in (1..5) -%}
                    {%- if i <= rating_num -%}
                      <svg viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 20 20" style="opacity: 0.25;">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- Mobile Pagination Dots -->
      {%- if section.settings.enable_slider_mobile and section.blocks.size > 1 -%}
        <div class="travel-reviews-slider-dots" aria-hidden="true">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="travel-reviews-dot{% if forloop.first %} is-active{% endif %}"
              aria-label="Go to review {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo Banner & Reviews",
  "tag": "section",
  "class": "section-travel-promo-reviews",
  "settings": [
    {
      "type": "header",
      "content": "Promotional Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show promotional banner",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "banner_fallback_image",
      "label": "Fallback Asset Name",
      "default": "promo-mountain-bg.jpg"
    },
    {
      "type": "text",
      "id": "banner_badge",
      "label": "Badge Text",
      "default": "SPECIAL OFFER"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner Heading",
      "default": "Up to 20% Off on Selected Tours"
    },
    {
      "type": "text",
      "id": "banner_subheading",
      "label": "Banner Subheading",
      "default": "Explore more. Spend less. Make it happen."
    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Button Text",
      "default": "View Offers"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "reviews_title",
      "label": "Section Title",
      "default": "What Our Travelers Say"
    },
    {
      "type": "select",
      "id": "reviews_title_alignment",
      "label": "Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "reviews_columns_desktop",
      "label": "Reviews per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_slider_mobile",
      "label": "Enable swipe carousel on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Traveler Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Reviewer Avatar Photo"
        },
        {
          "type": "text",
          "id": "fallback_avatar",
          "label": "Fallback Avatar Asset",
          "default": "avatar-priya.jpg"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Traveler Name",
          "default": "Priya Sharma"
        },
        {
          "type": "text",
          "id": "reviewer_location",
          "label": "Traveler Location",
          "default": "Kolkata, India"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Quote",
          "default": "An amazing experience! Everything was perfectly organized. Highly recommend Tour and Travel Wings!"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating (1 - 5)",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Banner & Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "fallback_avatar": "avatar-priya.jpg",
            "reviewer_name": "Priya Sharma",
            "reviewer_location": "Kolkata, India",
            "review_text": "An amazing experience! Everything was perfectly organized. Highly recommend Tour and Travel Wings!",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "fallback_avatar": "avatar-rahul.jpg",
            "reviewer_name": "Rahul Mehta",
            "reviewer_location": "Delhi, India",
            "review_text": "The team was very helpful and made our Europe trip truly special. Will book again!",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "fallback_avatar": "avatar-sneha.jpg",
            "reviewer_name": "Sneha Das",
            "reviewer_location": "Mumbai, India",
            "review_text": "Smooth booking process, great hotels and incredible destinations. Thank you!",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}


{% comment %}
  Popular Tours Section
  Tour & Travel Wings
{% endcomment %}

{{ 'popular-tours.css' | asset_url | stylesheet_tag }}

<div
  id="popular-tours-{{ section.id }}"
  class="popular-tours-section"
  data-section-id="{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    --pt-columns-desktop: {{ section.settings.columns_desktop }};
    --pt-color-navy: {{ section.settings.title_color }};
    --pt-card-bg: {{ section.settings.card_background }};
    --pt-color-gold: {{ section.settings.button_bg_color }};
    --pt-color-gold-hover: {{ section.settings.button_hover_bg_color }};
  "
>
  <div class="popular-tours-container">
    <!-- Header Row (Section Title & View All Link) -->
    <div class="popular-tours-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="popular-tours-title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.view_all_text != blank -%}
        <a
          href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
          class="popular-tours-view-all"
        >
          <span>{{ section.settings.view_all_text }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <!-- Tours Grid -->
    <div class="popular-tours-grid{% if section.settings.enable_mobile_scroll %} is-mobile-scroll{% endif %}">
      {%- assign tour_collection = section.settings.collection -%}
      {%- if tour_collection == blank -%}
        {%- assign tour_collection = collections.all -%}
      {%- endif -%}

      {%- if section.settings.source == 'collection' and tour_collection != blank and tour_collection.products_count > 0 -%}
        <!-- Render from Shopify Collection -->
        {%- for product in tour_collection.products limit: section.settings.products_to_show -%}
          <div class="popular-tour-card" data-product-id="{{ product.id }}">
            <div class="popular-tour-media-wrap">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'popular-tour-media',
                    alt: product.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'popular-tour-media' }}
              {%- endif -%}
            </div>

            <div class="popular-tour-content">
              <div class="popular-tour-title-wrap">
                <h3 class="popular-tour-title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
              </div>

              <!-- Location Meta -->
              {%- assign location_val = product.metafields.custom.location | default: product.type | default: product.vendor -%}
              {%- if location_val != blank -%}
                <div class="popular-tour-meta-row">
                  <span class="popular-tour-meta-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </span>
                  <span class="popular-tour-location-text">{{ location_val }}</span>
                </div>
              {%- endif -%}

              <!-- Duration Meta -->
              {%- assign days_val = product.metafields.custom.days | default: '7 Days' -%}
              {%- assign nights_val = product.metafields.custom.nights | default: '6 Nights' -%}
              <div class="popular-tour-duration-row">
                <span class="popular-tour-duration-item">
                  <span class="popular-tour-duration-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  </span>
                  <span>{{ days_val }}</span>
                </span>
                <span class="popular-tour-duration-item">
                  <span class="popular-tour-duration-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                    </svg>
                  </span>
                  <span>{{ nights_val }}</span>
                </span>
              </div>

              <!-- Card Footer: Price & CTA Button -->
              <div class="popular-tour-footer">
                <div class="popular-tour-price-wrap">
                  <span class="popular-tour-price">{{ product.price | money_without_trailing_zeros }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="popular-tour-compare-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                  {%- endif -%}
                </div>
                <a href="{{ product.url }}" class="popular-tour-btn">
                  {{ section.settings.default_btn_text | default: 'Book Now' }}
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}

      {%- else -%}
        <!-- Render from Custom Blocks -->
        {%- for block in section.blocks limit: section.settings.products_to_show -%}
          {%- assign card_img = block.settings.image -%}
          {%- assign fallback_img = block.settings.fallback_image -%}
          {%- if card_img != blank -%}
            {%- assign img_url = card_img | image_url: width: 800 -%}
          {%- elsif fallback_img != blank -%}
            {%- assign img_url = fallback_img | asset_url -%}
          {%- else -%}
            {%- assign img_url = 'hero-santorini.jpg' | asset_url -%}
          {%- endif -%}

          <div
            id="tour-card-{{ block.id }}"
            class="popular-tour-card"
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <!-- Media Area -->
            <div class="popular-tour-media-wrap">
              <img
                src="{{ img_url }}"
                alt="{{ block.settings.title | escape }}"
                class="popular-tour-media"
                loading="lazy"
                width="800"
                height="500"
              >
              {%- if block.settings.badge != blank -%}
                <span class="popular-tour-badge">{{ block.settings.badge }}</span>
              {%- endif -%}
            </div>

            <!-- Content Area -->
            <div class="popular-tour-content">
              <!-- Title -->
              <div class="popular-tour-title-wrap">
                <h3 class="popular-tour-title">
                  <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                    {{ block.settings.title }}
                  </a>
                </h3>
              </div>

              <!-- Location Row -->
              {%- if block.settings.location != blank -%}
                <div class="popular-tour-meta-row">
                  <span class="popular-tour-meta-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </span>
                  <span class="popular-tour-location-text">{{ block.settings.location }}</span>
                </div>
              {%- endif -%}

              <!-- Duration Row (Days & Nights) -->
              {%- if block.settings.days != blank or block.settings.nights != blank -%}
                <div class="popular-tour-duration-row">
                  {%- if block.settings.days != blank -%}
                    <span class="popular-tour-duration-item">
                      <span class="popular-tour-duration-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                      </span>
                      <span>{{ block.settings.days }}</span>
                    </span>
                  {%- endif -%}

                  {%- if block.settings.nights != blank -%}
                    <span class="popular-tour-duration-item">
                      <span class="popular-tour-duration-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                        </svg>
                      </span>
                      <span>{{ block.settings.nights }}</span>
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <!-- Card Footer: Price & CTA Button -->
              <div class="popular-tour-footer">
                <div class="popular-tour-price-wrap">
                  <span class="popular-tour-price">{{ block.settings.price }}</span>
                  {%- if block.settings.compare_price != blank -%}
                    <span class="popular-tour-compare-price">{{ block.settings.compare_price }}</span>
                  {%- endif -%}
                </div>

                <a
                  href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                  class="popular-tour-btn"
                >
                  {{ block.settings.button_label | default: 'Book Now' }}
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Popular Tours",
  "class": "section-popular-tours",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Tours"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Label",
      "default": "View All Tours"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Layout & Data Source"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Content Source",
      "options": [
        { "value": "blocks", "label": "Custom Blocks (Recommended)" },
        { "value": "collection", "label": "Shopify Collection" }
      ],
      "default": "blocks",
      "info": "Choose custom blocks for manual tour packages, or collection to pull from products."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when Content Source is set to Shopify Collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_scroll",
      "label": "Enable horizontal scroll on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading & Price Color",
      "default": "#0a2e5c"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#f5a623"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "#d9921b"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tour_card",
      "name": "Tour Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tour Image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback Asset Image",
          "default": "tour-bali.jpg",
          "info": "Filename from assets folder if no image is uploaded."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (Optional)",
          "info": "e.g. Featured, Best Seller"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tour Name",
          "default": "Bali Escape"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Destination / Location",
          "default": "Indonesia"
        },
        {
          "type": "text",
          "id": "days",
          "label": "Days",
          "default": "7 Days"
        },
        {
          "type": "text",
          "id": "nights",
          "label": "Nights",
          "default": "6 Nights"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$799"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Original Price (Optional)",
          "info": "Strikethrough discount price, e.g. $999"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Book Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Tour Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Popular Tours",
      "blocks": [
        {
          "type": "tour_card",
          "settings": {
            "title": "Bali Escape",
            "location": "Indonesia",
            "days": "7 Days",
            "nights": "6 Nights",
            "price": "$799",
            "fallback_image": "tour-bali.jpg",
            "button_label": "Book Now"
          }
        },
        {
          "type": "tour_card",
          "settings": {
            "title": "Swiss Alps Adventure",
            "location": "Switzerland",
            "days": "9 Days",
            "nights": "7 Nights",
            "price": "$1,299",
            "fallback_image": "tour-swiss-alps.jpg",
            "button_label": "Book Now"
          }
        },
        {
          "type": "tour_card",
          "settings": {
            "title": "Dubai Getaway",
            "location": "UAE",
            "days": "5 Days",
            "nights": "4 Nights",
            "price": "$899",
            "fallback_image": "tour-dubai.jpg",
            "button_label": "Book Now"
          }
        },
        {
          "type": "tour_card",
          "settings": {
            "title": "Thailand Discovery",
            "location": "Thailand",
            "days": "6 Days",
            "nights": "5 Nights",
            "price": "$749",
            "fallback_image": "tour-thailand.jpg",
            "button_label": "Book Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}

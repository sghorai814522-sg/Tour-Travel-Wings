{% comment %}
  The Grand Bento Travel Gallery - Luxury Edition
  Tour & Travel Wings
{% endcomment %}

{{ 'luxury-gallery.css' | asset_url | stylesheet_tag }}

<div
  id="LuxuryGallery-{{ section.id }}"
  class="luxury-gallery-page"
  data-section-id="{{ section.id }}"
  data-section-type="luxury-gallery"
>
  <!-- 1. Hero Header Banner -->
  <section class="lg-hero">
    <picture class="lg-hero-bg-picture">
      {%- liquid
        assign mobile_bg = ''
        if section.settings.image_mobile != blank
          assign mobile_bg = section.settings.image_mobile | image_url: width: 1080
        elsif section.settings.external_image_mobile != blank
          assign mobile_bg = section.settings.external_image_mobile
        else
          assign mobile_bg = 'hero-maldives.jpg' | asset_url
        endif

        assign desktop_bg = ''
        if section.settings.image_desktop != blank
          assign desktop_bg = section.settings.image_desktop | image_url: width: 2200
        elsif section.settings.external_image_desktop != blank
          assign desktop_bg = section.settings.external_image_desktop
        else
          assign desktop_bg = 'hero-santorini.jpg' | asset_url
        endif
      -%}
      <source media="(max-width: 768px)" srcset="{{ mobile_bg }}">
      <img
        class="lg-hero-bg-img"
        src="{{ desktop_bg }}"
        alt="{{ section.settings.hero_title | default: 'Travel Gallery Hero Background' | escape }}"
        loading="eager"
        width="1920"
        height="700"
      >
    </picture>
    <div class="lg-hero-overlay" style="opacity: {{ section.settings.overlay_opacity | default: 78 | divided_by: 100.0 }};"></div>
    <div class="lg-hero-glow" aria-hidden="true"></div>

    <div class="lg-hero-content">
      {%- if section.settings.hero_badge != blank -%}
        <div class="lg-hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {{ section.settings.hero_badge }}
        </div>
      {%- endif -%}

      <h1 class="lg-hero-title">
        {{ section.settings.hero_title | default: 'The Grand Bento Travel Gallery' }}
      </h1>

      {%- if section.settings.hero_subtitle != blank -%}
        <p class="lg-hero-subtitle">
          {{ section.settings.hero_subtitle }}
        </p>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <div class="lg-search-bar">
          <svg class="lg-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="text"
            id="lgSearchInput"
            class="lg-search-input"
            placeholder="Search country, destination, or keyword (e.g. Maldives, Swiss, Safari)..."
            autocomplete="off"
            aria-label="Search gallery destinations"
          >
          <button type="button" id="lgSearchClear" class="lg-search-clear" aria-label="Clear search">&times;</button>
        </div>
      {%- endif -%}

      {%- if section.settings.show_stats -%}
        <div class="lg-hero-stats">
          <div class="lg-hero-stat-item">
            <span class="lg-hero-stat-num">50</span>
            <span class="lg-hero-stat-lbl">Curated Wonders</span>
          </div>
          <div class="lg-hero-stat-item">
            <span class="lg-hero-stat-num">6</span>
            <span class="lg-hero-stat-lbl">Continents</span>
          </div>
          <div class="lg-hero-stat-item">
            <span class="lg-hero-stat-num">100%</span>
            <span class="lg-hero-stat-lbl">Ultra-Luxury Standard</span>
          </div>
          <div class="lg-hero-stat-item">
            <span class="lg-hero-stat-num">24/7</span>
            <span class="lg-hero-stat-lbl">VIP Concierge</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>

  <!-- 2. Sticky Filter & Toolbar -->
  {%- if section.settings.show_filters -%}
    <div class="lg-toolbar-sticky">
      <div class="lg-container">
        <div class="lg-toolbar">
          <div class="lg-filter-tabs" id="lgFilterTabs">
            <button type="button" class="lg-tab-btn active" data-filter="all">
              <span>All Escapes</span>
              <span class="lg-tab-count">{{ section.blocks.size }}</span>
            </button>
            <button type="button" class="lg-tab-btn" data-filter="tropical">
              <span>Tropical &amp; Islands</span>
            </button>
            <button type="button" class="lg-tab-btn" data-filter="alpine">
              <span>Alpine &amp; Peaks</span>
            </button>
            <button type="button" class="lg-tab-btn" data-filter="heritage">
              <span>Palaces &amp; Heritage</span>
            </button>
            <button type="button" class="lg-tab-btn" data-filter="modern">
              <span>Modern Skylines</span>
            </button>
            <button type="button" class="lg-tab-btn" data-filter="desert">
              <span>Desert &amp; Safari</span>
            </button>
          </div>

          <div class="lg-view-status" id="lgViewStatus">
            Showing <strong id="lgVisibleCount">{{ section.blocks.size }}</strong> of <strong>{{ section.blocks.size }}</strong> destinations
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- 3. Bento Grid Section (50 Escapes) -->
  <main class="lg-main">
    <div class="lg-container">
      <div class="lg-bento-grid" id="lgBentoGrid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign img_url = ''
            if block.settings.image != blank
              assign img_url = block.settings.image | image_url: width: 1200
            elsif block.settings.external_image_url != blank
              assign img_url = block.settings.external_image_url
            endif

            assign bento_span = block.settings.bento_span | default: 'span-4'
          -%}

          <article
            class="lg-dest-card {{ bento_span }}"
            data-index="{{ forloop.index0 }}"
            data-category="{{ block.settings.category | default: 'tropical' }}"
            data-title="{{ block.settings.title | escape }}"
            data-location="{{ block.settings.location | escape }}"
            data-desc="{{ block.settings.description | escape }}"
            data-full-img="{{ img_url }}"
            data-link="{{ block.settings.link | default: routes.root_url | append: 'pages/contact' }}"
            tabindex="0"
            role="button"
            aria-label="View details for {{ block.settings.title }}"
            {{ block.shopify_attributes }}
          >
            <img
              src="{{ img_url }}"
              alt="{{ block.settings.title | escape }}"
              class="lg-dest-img"
              loading="lazy"
              width="600"
              height="450"
            >
            <div class="lg-dest-overlay"></div>

            <!-- Top Badges -->
            <div class="lg-dest-top">
              <span class="lg-dest-category-badge">{{ block.settings.tag | default: block.settings.category | upcase }}</span>
              <div class="lg-dest-zoom-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
              </div>
            </div>

            <!-- Bottom Content -->
            <div class="lg-dest-bottom">
              <div class="lg-dest-location">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{{ block.settings.location }}</span>
              </div>

              <h2 class="lg-dest-title">{{ block.settings.title }}</h2>
              <p class="lg-dest-desc">{{ block.settings.description }}</p>

              <div class="lg-dest-action">
                <span>Explore Escape</span>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
          </article>
        {%- endfor -%}

      </div>
    </div>
  </main>

  <!-- 4. Interactive Lightbox Modal -->
  {%- if section.settings.enable_lightbox -%}
    <div id="lgModal" class="lg-modal" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="lg-modal-container">
        <button type="button" class="lg-modal-close" id="lgModalClose" aria-label="Close modal">&times;</button>
        <button type="button" class="lg-modal-nav lg-modal-prev" id="lgModalPrev" aria-label="Previous escape">&#10094;</button>
        <button type="button" class="lg-modal-nav lg-modal-next" id="lgModalNext" aria-label="Next escape">&#10095;</button>

        <div class="lg-modal-image-col">
          <img id="lgModalImg" class="lg-modal-img" src="" alt="Destination Escape">
        </div>

        <div class="lg-modal-info-col">
          <div>
            <span id="lgModalTag" class="lg-modal-tag"></span>
            <h3 id="lgModalTitle" class="lg-modal-title"></h3>
            <div id="lgModalLoc" class="lg-modal-loc">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span></span>
            </div>
            <p id="lgModalDesc" class="lg-modal-desc"></p>
          </div>

          <div>
            <a id="lgModalCta" href="/pages/contact" class="lg-modal-cta">
              <span>Reserve This Escape</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const grid = document.getElementById('lgBentoGrid');
  if (!grid) return;

  const cards = Array.from(grid.querySelectorAll('.lg-dest-card'));
  const filterTabs = document.querySelectorAll('#lgFilterTabs .lg-tab-btn');
  const searchInput = document.getElementById('lgSearchInput');
  const searchClear = document.getElementById('lgSearchClear');
  const visibleCount = document.getElementById('lgVisibleCount');

  // Filter functionality
  let currentFilter = 'all';
  let searchQuery = '';

  function applyFilters() {
    let count = 0;
    cards.forEach(card => {
      const cat = card.getAttribute('data-category');
      const title = (card.getAttribute('data-title') || '').toLowerCase();
      const loc = (card.getAttribute('data-location') || '').toLowerCase();

      const matchCat = (currentFilter === 'all' || cat === currentFilter);
      const matchSearch = (!searchQuery || title.includes(searchQuery) || loc.includes(searchQuery));

      if (matchCat && matchSearch) {
        card.style.display = '';
        count++;
      } else {
        card.style.display = 'none';
      }
    });

    if (visibleCount) {
      visibleCount.textContent = count;
    }
  }

  filterTabs.forEach(tab => {
    tab.addEventListener('click', function() {
      filterTabs.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      currentFilter = this.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      searchQuery = this.value.trim().toLowerCase();
      if (searchClear) {
        searchClear.style.display = searchQuery ? 'block' : 'none';
      }
      applyFilters();
    });
  }

  if (searchClear) {
    searchClear.addEventListener('click', function() {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        this.style.display = 'none';
        applyFilters();
      }
    });
  }

  // Lightbox Modal
  const modal = document.getElementById('lgModal');
  const modalImg = document.getElementById('lgModalImg');
  const modalTitle = document.getElementById('lgModalTitle');
  const modalLoc = document.getElementById('lgModalLoc');
  const modalTag = document.getElementById('lgModalTag');
  const modalDesc = document.getElementById('lgModalDesc');
  const modalClose = document.getElementById('lgModalClose');
  const modalPrev = document.getElementById('lgModalPrev');
  const modalNext = document.getElementById('lgModalNext');
  const modalCta = document.getElementById('lgModalCta');

  let activeIndex = 0;
  const visibleCards = () => cards.filter(c => c.style.display !== 'none');

  function openModal(card) {
    if (!modal) return;
    const img = card.getAttribute('data-full-img');
    const title = card.getAttribute('data-title');
    const loc = card.getAttribute('data-location');
    const tag = card.querySelector('.lg-dest-category-badge')?.textContent || '';
    const desc = card.getAttribute('data-desc');
    const link = card.getAttribute('data-link');

    if (modalImg) modalImg.src = img;
    if (modalTitle) modalTitle.textContent = title;
    if (modalLoc) modalLoc.querySelector('span').textContent = loc;
    if (modalTag) modalTag.textContent = tag;
    if (modalDesc) modalDesc.textContent = desc;
    if (modalCta && link) modalCta.href = link;

    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  cards.forEach(card => {
    card.addEventListener('click', function(e) {
      const vis = visibleCards();
      activeIndex = vis.indexOf(this);
      openModal(this);
    });
  });

  if (modalClose) modalClose.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });
  }

  if (modalPrev) {
    modalPrev.addEventListener('click', function(e) {
      e.stopPropagation();
      const vis = visibleCards();
      if (!vis.length) return;
      activeIndex = (activeIndex - 1 + vis.length) % vis.length;
      openModal(vis[activeIndex]);
    });
  }

  if (modalNext) {
    modalNext.addEventListener('click', function(e) {
      e.stopPropagation();
      const vis = visibleCards();
      if (!vis.length) return;
      activeIndex = (activeIndex + 1) % vis.length;
      openModal(vis[activeIndex]);
    });
  }

  document.addEventListener('keydown', function(e) {
    if (!modal || !modal.classList.contains('active')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft' && modalPrev) modalPrev.click();
    if (e.key === 'ArrowRight' && modalNext) modalNext.click();
  });
});
</script>

{% schema %}
{
  "name": "Luxury Bento Gallery",
  "tag": "section",
  "class": "luxury-bento-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero Badge Text",
      "default": "CURATED LUXURY WONDERS"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "The Grand Bento Travel Gallery"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Discover fifty breathtaking sanctuaries, private atolls, alpine summits, and historic palaces arranged in a modern modular showcase."
    },
    {
      "type": "header",
      "content": "Hero Background Images (Desktop & Mobile)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Hero Background Image"
    },
    {
      "type": "url",
      "id": "external_image_desktop",
      "label": "External Desktop Background Image URL"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Hero Background Image"
    },
    {
      "type": "url",
      "id": "external_image_mobile",
      "label": "External Mobile Background Image URL"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Hero Overlay Darkness %",
      "min": 30,
      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 75
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Live Search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Category Filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show Stats Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Enable Fullscreen Lightbox",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Bento Destination Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Destination Title",
          "default": "Overwater Villa Serenity"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "South Ari Atoll, Maldives"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "tropical", "label": "Tropical & Islands" },
            { "value": "alpine", "label": "Alpine & Peaks" },
            { "value": "heritage", "label": "Palaces & Heritage" },
            { "value": "modern", "label": "Modern Skylines" },
            { "value": "desert", "label": "Desert & Safari" }
          ],
          "default": "tropical"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category Tag / Badge",
          "default": "PRIVATE ATOLL"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short Description",
          "default": "Suspended above turquoise waters with infinity sundecks."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Image"
        },
        {
          "type": "url",
          "id": "external_image_url",
          "label": "External Image URL"
        },
        {
          "type": "select",
          "id": "bento_span",
          "label": "Bento Grid Span",
          "options": [
            { "value": "span-3", "label": "Compact (3 cols)" },
            { "value": "span-4", "label": "Standard (4 cols)" },
            { "value": "span-5", "label": "Wide (5 cols)" },
            { "value": "span-6", "label": "Half Row (6 cols)" },
            { "value": "span-7", "label": "Large (7 cols)" },
            { "value": "span-8", "label": "Extra Wide (8 cols)" },
            { "value": "span-12", "label": "Full Row (12 cols)" }
          ],
          "default": "span-4"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Destination Link"
        }
      ]
    }
  ]
}
{% endschema %}

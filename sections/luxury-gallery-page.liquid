{% comment %}
  The Grand Travel Gallery - Luxury Edition
  Tour & Travel Wings
{% endcomment %}

{{ 'luxury-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'luxury-gallery.js' | asset_url }}" defer="defer"></script>

<div
  id="LuxuryGallery-{{ section.id }}"
  class="luxury-gallery-page"
  data-section-id="{{ section.id }}"
  data-section-type="luxury-gallery"
>
  <!-- 1. Hero Header Banner -->
  <section class="lg-hero">
    <div class="lg-hero-pattern" aria-hidden="true"></div>
    <div class="lg-hero-glow" aria-hidden="true"></div>

    <div class="lg-hero-content">
      {%- if section.settings.hero_badge != blank -%}
        <div class="lg-hero-badge">
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {{ section.settings.hero_badge }}
        </div>
      {%- endif -%}

      <h1 class="lg-hero-title">
        {{ section.settings.hero_title | default: 'The Grand Travel Gallery' }}
      </h1>

      {%- if section.settings.hero_subtitle != blank -%}
        <p class="lg-hero-subtitle">
          {{ section.settings.hero_subtitle }}
        </p>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <div class="lg-search-bar">
          <svg class="lg-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="text"
            id="lgSearchInput"
            class="lg-search-input"
            placeholder="Search country, destination, or keyword (e.g. Maldives, Swiss, Safari)..."
            autocomplete="off"
            aria-label="Search gallery destinations"
          >
          <button type="button" id="lgSearchClear" class="lg-search-clear" aria-label="Clear search">&times;</button>
        </div>
      {%- endif -%}

      {%- if section.settings.show_stats -%}
        <div class="lg-hero-stats">
          <div class="lg-hero-stat-item">
            <span class="lg-hero-stat-num">50+</span>
            <span class="lg-hero-stat-lbl">Curated Wonders</span>
          </div>
          <div class="lg-hero-stat-item">
            <span class="lg-hero-stat-num">6</span>
            <span class="lg-hero-stat-lbl">Continents</span>
          </div>
          <div class="lg-hero-stat-item">
            <span class="lg-hero-stat-num">100%</span>
            <span class="lg-hero-stat-lbl">Ultra-Luxury Standard</span>
          </div>
          <div class="lg-hero-stat-item">
            <span class="lg-hero-stat-num">24/7</span>
            <span class="lg-hero-stat-lbl">VIP Concierge</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>

  <!-- 2. Sticky Filter & Toolbar -->
  <div class="lg-toolbar-sticky">
    <div class="lg-container">
      <div class="lg-toolbar">
        <!-- Category Filter Tabs -->
        <div class="lg-filters" role="tablist" aria-label="Gallery Categories">
          <button type="button" class="lg-filter-btn active" data-filter="all">
            <span>All Escapes</span>
            <span class="lg-filter-count">{{ section.blocks.size }}</span>
          </button>
          <button type="button" class="lg-filter-btn" data-filter="tropical">
            <span>Tropical & Islands</span>
          </button>
          <button type="button" class="lg-filter-btn" data-filter="alpine">
            <span>Alpine & Peaks</span>
          </button>
          <button type="button" class="lg-filter-btn" data-filter="heritage">
            <span>Palaces & Heritage</span>
          </button>
          <button type="button" class="lg-filter-btn" data-filter="modern">
            <span>Modern Skylines</span>
          </button>
          <button type="button" class="lg-filter-btn" data-filter="desert">
            <span>Desert & Safari</span>
          </button>
        </div>

        <!-- Controls: View Status & Layout Toggles -->
        <div class="lg-controls">
          <div class="lg-view-status" id="lgViewStatus">
            Showing <strong>16</strong> of <strong>{{ section.blocks.size }}</strong> escapes
          </div>

          <div class="lg-layout-toggles">
            <button type="button" class="lg-layout-btn active" data-cols="4" title="4 Columns Grid" aria-label="4 Columns Grid">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h4v18H3zm7 0h4v18h-4zm7 0h4v18h-4z"/></svg>
            </button>
            <button type="button" class="lg-layout-btn" data-cols="3" title="3 Columns Grid" aria-label="3 Columns Grid">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h4v16H4zm6 0h4v16h-4zm6 0h4v16h-4z"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Gallery Grid Section -->
  <main class="lg-main">
    <div class="lg-container">
      <div class="lg-grid" id="lgGrid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign img_url = ''
            if block.settings.image != blank
              assign img_url = block.settings.image | image_url: width: 1200
            elsif block.settings.external_image_url != blank
              assign img_url = block.settings.external_image_url
            endif

            assign aspect_class = ''
            if block.settings.aspect_ratio == 'tall'
              assign aspect_class = 'tall'
            elsif block.settings.aspect_ratio == 'wide'
              assign aspect_class = 'wide'
            endif
          -%}

          <article
            class="lg-card {{ aspect_class }}"
            data-index="{{ forloop.index0 }}"
            data-category="{{ block.settings.category | default: 'tropical' }}"
            data-title="{{ block.settings.title | escape }}"
            data-location="{{ block.settings.location | escape }}"
            data-desc="{{ block.settings.description | escape }}"
            data-full-img="{{ img_url }}"
            data-link="{{ block.settings.link | default: routes.root_url | append: 'pages/contact' }}"
            tabindex="0"
            role="button"
            aria-label="View details for {{ block.settings.title }}"
            {{ block.shopify_attributes }}
          >
            <div class="lg-card-media">
              <img
                src="{{ img_url }}"
                alt="{{ block.settings.title | escape }}"
                class="lg-card-img"
                loading="lazy"
                width="600"
                height="750"
              >
            </div>
            <div class="lg-card-overlay"></div>

            <!-- Top Tag & Zoom Icon -->
            <div class="lg-card-top">
              <span class="lg-card-category-tag">
                {{ block.settings.tag | default: block.settings.category | upcase }}
              </span>
              <div class="lg-card-zoom-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
              </div>
            </div>

            <!-- Bottom Content -->
            <div class="lg-card-bottom">
              {%- if block.settings.location != blank -%}
                <div class="lg-card-location">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>{{ block.settings.location }}</span>
                </div>
              {%- endif -%}

              <h2 class="lg-card-title">{{ block.settings.title }}</h2>

              {%- if block.settings.description != blank -%}
                <p class="lg-card-desc">{{ block.settings.description }}</p>
              {%- endif -%}

              <div class="lg-card-footer-action">
                <span>Explore Details</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
          </article>
        {%- endfor -%}

        <!-- Empty Search State -->
        <div class="lg-empty-state" id="lgEmptyState">
          <svg class="lg-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          <h3 class="lg-empty-title">No Luxury Escapes Found</h3>
          <p class="lg-empty-text">We couldn't find any destinations matching your search. Try another query or reset the filter.</p>
          <button type="button" class="lg-empty-btn" id="lgEmptyResetBtn">Reset All Filters</button>
        </div>
      </div>

      <!-- Load More / Progressive Progress Bar -->
      <div class="lg-load-more-wrap" id="lgLoadMoreWrap">
        <div class="lg-progress-bar-outer" aria-hidden="true">
          <div class="lg-progress-bar-fill" id="lgProgressFill" style="width: 32%;"></div>
        </div>
        <div class="lg-progress-text" id="lgProgressText">
          Revealed 16 of {{ section.blocks.size }} wonders
        </div>
        <button type="button" class="lg-load-more-btn" id="lgLoadMoreBtn">
          <span>Reveal More Exclusive Escapes</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      </div>
    </div>
  </main>

  <!-- 4. Fullscreen Luxury Lightbox Modal -->
  <div class="lg-lightbox" id="lgLightbox" role="dialog" aria-modal="true" aria-label="Travel Image Preview">
    <!-- Top Bar -->
    <div class="lg-lb-topbar">
      <div class="lg-lb-counter" id="lgLbCounter">1 / 50</div>
      <div class="lg-lb-actions">
        <button type="button" class="lg-lb-action-btn" id="lgLbZoom" title="Toggle Zoom" aria-label="Toggle Zoom">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        </button>
        <button type="button" class="lg-lb-action-btn" id="lgLbClose" title="Close (Esc)" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Middle Stage -->
    <div class="lg-lb-stage">
      <button type="button" class="lg-lb-nav-btn lg-lb-prev" id="lgLbPrev" title="Previous" aria-label="Previous Escape">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="lg-lb-img-wrap">
        <img src="" alt="" class="lg-lb-img" id="lgLbImg">
      </div>

      <button type="button" class="lg-lb-nav-btn lg-lb-next" id="lgLbNext" title="Next" aria-label="Next Escape">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <!-- Bottom Info Panel -->
    <div class="lg-lb-info">
      <div class="lg-lb-info-content">
        <div class="lg-lb-info-meta">
          <span class="lg-lb-info-category" id="lgLbCategory">TROPICAL & ISLANDS</span>
          <span class="lg-lb-info-location" id="lgLbLocation">Maldives</span>
        </div>
        <h3 class="lg-lb-info-title" id="lgLbTitle">Overwater Villa Haven</h3>
        <p class="lg-lb-info-desc" id="lgLbDesc"></p>
      </div>

      <a href="#" class="lg-lb-inquire-btn" id="lgLbInquireBtn">
        <span>Inquire About This Escape</span>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Gallery Page",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner Settings"
    },
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Badge Text",
      "default": "EXCLUSIVELY CURATED ANTHOLOGY"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Heading",
      "default": "The Grand Travel Gallery"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "An exclusive visual anthology of the world's most breathtaking escapes, private sanctuaries, and timeless wonders."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Enable Live Destination Search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show Luxury Stats Bar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Gallery Escape",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Destination Title",
          "default": "Overwater Villa Serenity"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Country / Location",
          "default": "South Ari Atoll, Maldives"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category Tab",
          "options": [
            { "value": "tropical", "label": "Tropical & Islands" },
            { "value": "alpine", "label": "Alpine & Peaks" },
            { "value": "heritage", "label": "Palaces & Heritage" },
            { "value": "modern", "label": "Modern Skylines" },
            { "value": "desert", "label": "Desert & Safari" }
          ],
          "default": "tropical"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Floating Tag (e.g. PRIVATE ATOLL)",
          "default": "EXCLUSIVE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Narrative Description",
          "default": "Handcrafted luxury holiday experience across extraordinary landscapes."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Shopify Image (Overrides CDN URL)"
        },
        {
          "type": "text",
          "id": "external_image_url",
          "label": "High-Res Image CDN URL"
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Tile Aspect Ratio",
          "options": [
            { "value": "standard", "label": "Standard (4:5)" },
            { "value": "tall", "label": "Tall Masonry (2 Rows)" },
            { "value": "wide", "label": "Wide Feature (2 Cols)" }
          ],
          "default": "standard"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Inquiry / Tour Link URL"
        }
      ]
    }
  ],
  "presets": [
    {

{%- comment -%}
  VMI Trust Section — Sankalp (Our Sacred Promise to Travelers in Incredible India)
  Left side: Iconic Indian tourist destination photography (Taj Mahal, Jaipur, Kashmir).
  Right side: Sankalp script & serif logo, subtitle, and cream 4-sided scalloped box with tourist mission text.
  Full section background image or gradient options.
{%- endcomment -%}

{%- if section.settings.enable_section -%}

{%- liquid
  assign sec_subtitle = section.settings.subtitle
  if sec_subtitle == blank or sec_subtitle contains 'ARTISAN' or sec_subtitle contains 'Artisan'
    assign sec_subtitle = 'OUR SACRED PROMISE TO OUR TRAVELERS'
  endif

  assign sec_small_heading = section.settings.small_heading
  if sec_small_heading == blank or sec_small_heading contains 'Craftsmanship' or sec_small_heading contains 'craftsmanship'
    assign sec_small_heading = "Celebrating Incredible India's Wonders"
  endif

  assign sec_mission = section.settings.mission
  if sec_mission == blank or sec_mission contains 'Very Much Indian' or sec_mission contains 'weaves' or sec_mission contains 'artisans'
    assign sec_mission = '<p>At Tour &amp; Travel Wings, our sacred promise (Sankalp) is to curate extraordinary travel experiences across Incredible India. From the snow-capped Himalayan peaks of Kashmir to the royal palaces of Rajasthan and the tranquil backwaters of Kerala, we believe every journey should inspire, delight, and leave an everlasting memory.</p><p>When you journey with us, you experience world-class hospitality, empower local heritage custodians, and create treasured travel memories that endure for a lifetime.</p>'
  endif
-%}

<section
  class="vmi-trust vmi-section--full"
  id="vmi-trust-{{ section.id }}"
  style="
    {%- if section.settings.bg_image != blank -%}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {%- elsif section.settings.bg_fallback_image != blank -%}
      background-image: url('{{ section.settings.bg_fallback_image | asset_url }}');
      background-size: cover;
      background-position: center;
    {%- else -%}
      background: {{ section.settings.bg_gradient | default: 'linear-gradient(135deg, #CFDAE5 0%, #7B90A3 45%, #2B3E52 100%)' }};
    {%- endif -%}
    --vmi-card-bg: {{ section.settings.card_bg_color | default: '#F4EFE6' }};
    --vmi-trust-text: {{ section.settings.text_color | default: '#1E354D' }};
  "
>
  <div class="vmi-trust__split">

    {%- comment -%} LEFT COLUMN: Indian Heritage Tourist Destination Photography {%- endcomment -%}
    <div class="vmi-trust__left-media">
      {%- liquid
        assign left_img_src = ''
        if section.settings.left_image != blank
          assign left_img_src = section.settings.left_image | image_url: width: 1200
        elsif section.settings.left_image_url != blank
          assign left_img_src = section.settings.left_image_url
        else
          assign fallback_filename = section.settings.left_fallback_image | default: 'india-agra.jpg'
          assign left_img_src = fallback_filename | asset_url
        endif
      -%}
      <img
        src="{{ left_img_src }}"
        alt="{{ section.settings.heading | default: 'Taj Mahal - Incredible India Heritage' | escape }}"
        loading="lazy"
        class="vmi-trust__weaver-img"
        onerror="if (this.src !== 'https://images.unsplash.com/photo-1564507592333-c60657eea523?auto=format&fit=crop&w=1200&q=80') this.src = 'https://images.unsplash.com/photo-1564507592333-c60657eea523?auto=format&fit=crop&w=1200&q=80';"
      >
    </div>

    {%- comment -%} RIGHT COLUMN: Sankalp Header & Scalloped Tourist Mission Box {%- endcomment -%}
    <div class="vmi-trust__right-content">

      {%- comment -%} Sankalp Logo & Subtitle {%- endcomment -%}
      <div class="vmi-trust__header">
        <div class="vmi-trust__logo-wrap">
          {%- if section.settings.sankalp_logo_image != blank -%}
            <img src="{{ section.settings.sankalp_logo_image | image_url: width: 600 }}" alt="{{ section.settings.heading }}" class="vmi-trust__logo-img" style="max-width: {{ section.settings.logo_max_width | default: 240 }}px;">
          {%- else -%}
            {%- assign heading_text = section.settings.heading | default: 'Sankalp' -%}
            {%- assign first_char = heading_text | slice: 0, 1 -%}
            {%- assign rest_chars = heading_text | slice: 1, 100 -%}
            <div class="vmi-trust__logo-brand">
              <div class="vmi-trust__logo-text">
                <span class="vmi-trust__first-letter">{{ first_char }}</span>
                <span class="vmi-trust__rest-letters">{{ rest_chars }}</span>
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- if sec_subtitle != blank -%}
          <div class="vmi-trust__subtitle">
            {{ sec_subtitle | upcase }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Scalloped Frame Box with Tourist Mission Statement {%- endcomment -%}
      {%- assign scallop_bg = section.settings.scallop_bg_image | image_url: width: 1000 -%}
      {%- if scallop_bg == blank -%}
        {%- assign scallop_bg = 'https://cdn.shopify.com/s/files/1/0993/9274/9871/files/ChatGPT_Image_Jul_25_2026_07_10_52_AM_1.png?v=1786622256' -%}
      {%- endif -%}

      <div 
        class="vmi-trust__scalloped-box"
        style="background-image: url('{{ scallop_bg }}');"
      >
        <div class="vmi-trust__scallop-inner">
          {%- if sec_small_heading != blank -%}
            <div class="vmi-trust__small-heading">
              {{ sec_small_heading }}
            </div>
          {%- endif -%}

          {%- if sec_mission != blank -%}
            <div class="vmi-trust__mission-wrapper">
              <div class="vmi-trust__mission-text" id="vmi-trust-mission-{{ section.id }}">
                {{ sec_mission }}
              </div>
              <button type="button" class="vmi-trust__read-more-btn" onclick="toggleVmiTrustText('{{ section.id }}')">Read More</button>
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="vmi-trust__btn-wrap">
              <a
                href="{{ section.settings.button_link | default: '#' }}"
                class="vmi-trust__btn"
              >
                <span>{{ section.settings.button_label }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .vmi-trust {
    overflow: hidden;
    width: 100%;
    position: relative;
    margin-top: 50px;
  }

  .vmi-trust__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
    width: 100%;
    align-items: center;
  }

  /* ════════════════════════════════
     LEFT COLUMN: INDIAN DESTINATION PHOTOGRAPHY
  ════════════════════════════════ */
  .vmi-trust__left-media {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 2.5rem 2rem 2.5rem 3rem;
    box-sizing: border-box;
  }

  .vmi-trust__weaver-img {
    max-width: 100%;
    max-height: 560px;
    width: 100%;
    height: 100%;
    min-height: 460px;
    object-fit: cover;
    border-radius: 24px;
    display: block;
    box-shadow: 0 16px 40px rgba(15, 30, 45, 0.25);
    border: 4px solid rgba(255, 255, 255, 0.6);
    background: #e2e8f0;
  }

  /* ════════════════════════════════
     RIGHT COLUMN: SANKALP & CARD
  ════════════════════════════════ */
  .vmi-trust__right-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 2.5rem 3.5rem;
    position: relative;
    z-index: 1;
    width: 100%;
    box-sizing: border-box;
  }

  .vmi-trust__header {
    text-align: center;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Logo Typography: Script First Letter + Serif Rest */
  .vmi-trust__logo-brand {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }

  .vmi-trust__logo-text {
    display: flex;
    align-items: baseline;
    line-height: 1;
  }

  .vmi-trust__first-letter {
    font-family: var(--font-accent--family);
    font-size: 3.8rem;
    line-height: 0.8;
    color: var(--vmi-trust-text);
    margin-right: -0.08em;
  }

  .vmi-trust__rest-letters {
    font-family: var(--font-heading--family);
    font-size: 2.2rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--vmi-trust-text);
  }

  .vmi-trust__swash-svg {
    width: 92%;
    height: 10px;
    margin-top: -4px;
  }

  .vmi-trust__logo-img {
    max-width: 220px;
    height: auto;
    display: block;
  }

  .vmi-trust__subtitle {
    font-family: var(--font-body--family);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--vmi-trust-text);
    text-transform: uppercase;
    opacity: 0.92;
    margin-top: 0.4rem;
  }

  /* Scalloped Card */
  .vmi-trust__scalloped-box {
    position: relative;
    max-width: 650px;
    width: 100%;
    height: 600px;
    padding: 6.2rem 7rem 3rem 7rem;
    box-sizing: border-box;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position: center;
  }

  .vmi-trust__scallop-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    object-fit: fill;
  }

  .vmi-trust__scallop-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .vmi-trust__small-heading {
    font-family: var(--font-heading--family);
    font-size: 23px;
    color: #333333;
    margin-bottom: 1.25rem;
    letter-spacing: 0.01em;
    max-width: 340px;
    font-weight: 500;
    margin: 0 auto 0px;
    line-height: 1.3;
  }

  .vmi-trust__mission-text {
    font-family: var(--font-body--family);
    font-size: 0.92rem;
    line-height: 1.75;
    color: #3A3A3A;
    text-align: justify;
    font-weight: 400;
  }

  .vmi-trust__mission-text p {
    margin: 0 0 1rem 0;
    color: #545454;
  }

  .vmi-trust__mission-text p:last-child {
    margin-bottom: 0;
  }

  .vmi-trust__mission-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vmi-trust__mission-text {
    transition: all 0.3s ease;
  }

  .vmi-trust__read-more-btn {
    display: none;
    background: none;
    border: none;
    color: var(--vmi-trust-text, #1E354D);
    font-family: var(--font-body--family);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    margin: 12px auto 0;
    padding: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: opacity 0.2s ease;
  }
  
  .vmi-trust__read-more-btn:hover {
    opacity: 0.7;
  }

  /* Dynamic Call to Action Button */
  .vmi-trust__btn-wrap {
    margin-top: 1.25rem;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .vmi-trust__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--vmi-trust-text, #1E354D);
    color: #ffffff !important;
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.75rem 1.8rem;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(30, 53, 77, 0.22);
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .vmi-trust__btn:hover {
    background-color: #0b1724;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(30, 53, 77, 0.32);
    color: #ffffff !important;
  }

  .vmi-trust__btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .vmi-trust__btn:hover svg {
    transform: translateX(3px);
  }

  /* ════════════════════════════════
     RESPONSIVE
  ════════════════════════════════ */
  @media (max-width: 1024px) {
    .vmi-trust__right-content {
      padding: 2.5rem 1.8rem;
    }
    .vmi-trust__small-heading{
      margin-bottom: 0 !important;
    }

    .vmi-trust__scalloped-box {      
      position: relative;
      max-width: 650px;
      width: 100%;
      height: 100%;
      padding: 4.2rem 4rem 3rem 4rem;
      box-sizing: border-box;
      background-size: 100% 100%;
      padding-bottom: 66px !important;
      background-repeat: no-repeat;
    }
  }

  @media (max-width: 749px) {
    .vmi-trust {
      margin-top: 40px;
    }
    .vmi-trust__split {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .vmi-trust__left-media {
      min-height: 340px;
      padding: 1.5rem 1rem 0;
    }

    .vmi-trust__weaver-img {
      max-height: 360px;
      min-height: 260px;
      width: 100%;
    }

    .vmi-trust__right-content {
      padding: 2.5rem 1rem;
    }

    .vmi-trust__scalloped-box {
      max-width: 100%;
      padding: 3.5rem 2.2rem 3rem;
      height: auto;
    }

    .vmi-trust__mission-text {
      font-size: 0.88rem;
      line-height: 1.72;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .vmi-trust__mission-text.is-expanded {
      -webkit-line-clamp: unset;
    }

    .vmi-trust__read-more-btn {
      display: inline-block;
    }

    .vmi-trust__btn-wrap {
      margin-top: 1rem;
    }

    .vmi-trust__btn {
      padding: 0.68rem 1.5rem;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  function toggleVmiTrustText(sectionId) {
    var textContainer = document.getElementById('vmi-trust-mission-' + sectionId);
    if (!textContainer) return;
    var btn = textContainer.nextElementSibling;
    if (textContainer.classList.contains('is-expanded')) {
      textContainer.classList.remove('is-expanded');
      if (btn) btn.innerText = 'Read More';
    } else {
      textContainer.classList.add('is-expanded');
      if (btn) btn.innerText = 'Read Less';
    }
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "VMI Trust",
  "tag": "div",
  "class": "vmi-trust-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "header",
      "content": "Full Section Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Full section background image (optional)"
    },
    {
      "type": "text",
      "id": "bg_fallback_image",
      "label": "Background Asset Filename (optional)"
    },
    {
      "type": "text",
      "id": "bg_gradient",
      "label": "Full section background gradient / color",
      "default": "linear-gradient(135deg, #CFDAE5 0%, #7B90A3 45%, #2B3E52 100%)"
    },
    {
      "type": "header",
      "content": "Section Header & Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading / Logo text",
      "default": "Sankalp"
    },
    {
      "type": "image_picker",
      "id": "sankalp_logo_image",
      "label": "Upload Logo Image (SVG / Transparent PNG)",
      "info": "Upload an SVG or high-res transparent PNG logo. Overrides live text."
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Logo image width",
      "default": 240
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR SACRED PROMISE TO OUR TRAVELERS"
    },
    {
      "type": "header",
      "content": "Left Side Tourist Place Artwork"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left side tourist place photo"
    },
    {
      "type": "text",
      "id": "left_image_url",
      "label": "Left side image direct URL (optional)"
    },
    {
      "type": "text",
      "id": "left_fallback_image",
      "label": "Fallback Asset Image",
      "info": "e.g. india-agra.jpg, india-jaipur.jpg, india-kashmir.jpg",
      "default": "india-agra.jpg"
    },
    {
      "type": "header",
      "content": "Mission Box & Content"
    },
    {
      "type": "image_picker",
      "id": "scallop_bg_image",
      "label": "Custom Scalloped Card Frame Image"
    },
    {
      "type": "text",
      "id": "small_heading",
      "label": "Small card heading",
      "default": "Celebrating Incredible India's Wonders"
    },
    {
      "type": "richtext",
      "id": "mission",
      "label": "Mission statement text",
      "default": "<p>At Tour & Travel Wings, our sacred promise (Sankalp) is to deliver unparalleled luxury, authentic cultural encounters, and deeply soul-stirring journeys across Incredible India. From the snow-capped peaks of Kashmir to the royal palaces of Rajasthan and the serene backwaters of Kerala, every itinerary is handcrafted with passion.</p><p>When you journey with us, you experience world-class hospitality, empower local heritage custodians, and create treasured travel memories that endure for a lifetime.</p>"
    },
    {
      "type": "header",
      "content": "Action Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Our Journeys"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Color Customizations"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Scalloped card background",
      "default": "#F4EFE6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1E354D"
    }
  ],
  "presets": [
    {
      "name": "VMI Trust"
    }
  ]
}
{% endschema %}
{% comment %}
  Travel Contact Page Section
  Tour & Travel Wings - High Fidelity Custom Contact Template
{% endcomment %}

{{ 'travel-contact.css' | asset_url | stylesheet_tag }}

{%- assign hero_bg = section.settings.hero_image -%}
{%- assign hero_fallback = section.settings.hero_fallback_image | default: 'hero-maldives.jpg' -%}
{%- if hero_bg != blank -%}
  {%- assign hero_url = hero_bg | image_url: width: 2400 -%}
{%- else -%}
  {%- assign hero_url = hero_fallback | asset_url -%}
{%- endif -%}

<div
  id="travel-contact-section-{{ section.id }}"
  class="travel-contact-section"
  data-section-id="{{ section.id }}"
  style="
    --tc-padding-top: {{ section.settings.padding_top }}px;
    --tc-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <!-- 1. Top Hero Banner -->
  <div class="travel-contact-hero">
    <div
      class="travel-contact-hero-bg"
      style="background-image: url('{{ hero_url }}');"
    ></div>
    <div
      class="travel-contact-hero-overlay"
      style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    ></div>
    <div class="travel-contact-hero-content">
      <h1 class="travel-contact-hero-title">{{ section.settings.hero_title | escape }}</h1>
      {%- if section.settings.hero_subtitle != blank -%}
        <p class="travel-contact-hero-sub">{{ section.settings.hero_subtitle | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- 2. Main 2-Column Content Grid -->
  <div class="travel-contact-container">
    <div class="travel-contact-grid">
      
      <!-- LEFT COLUMN -->
      <div class="travel-contact-col travel-contact-col--left">
        <!-- Get In Touch Card -->
        <div class="travel-contact-card travel-contact-info-card">
          <h2 class="travel-contact-heading">{{ section.settings.info_heading | escape }}</h2>

          <div class="travel-contact-items">
            <!-- Item 1: Office Address -->
            <div class="travel-contact-item">
              <div class="travel-contact-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="travel-contact-item-content">
                <h3 class="travel-contact-item-title">{{ section.settings.office_title | escape }}</h3>
                <div class="travel-contact-item-text">
                  {{ section.settings.office_address | newline_to_br }}
                </div>
              </div>
            </div>

            <!-- Item 2: Phone -->
            <div class="travel-contact-item">
              <div class="travel-contact-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="travel-contact-item-content">
                <h3 class="travel-contact-item-title">{{ section.settings.phone_title | escape }}</h3>
                <div class="travel-contact-item-text">
                  <a href="tel:{{ section.settings.phone_number | replace: ' ', '' }}">{{ section.settings.phone_number }}</a>
                  {%- if section.settings.phone_whatsapp != blank -%}
                    <a href="https://wa.me/{{ section.settings.phone_whatsapp | replace: '+', '' | replace: ' ', '' }}" target="_blank" rel="noopener" class="travel-contact-wa-link">
                      {{ section.settings.phone_whatsapp }} (WhatsApp)
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>

            <!-- Item 3: Email -->
            <div class="travel-contact-item">
              <div class="travel-contact-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="travel-contact-item-content">
                <h3 class="travel-contact-item-title">{{ section.settings.email_title | escape }}</h3>
                <div class="travel-contact-item-text">
                  <a href="mailto:{{ section.settings.email_address }}">{{ section.settings.email_address }}</a>
                </div>
              </div>
            </div>

            <!-- Item 4: Business Hours -->
            <div class="travel-contact-item">
              <div class="travel-contact-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="travel-contact-item-content">
                <h3 class="travel-contact-item-title">{{ section.settings.hours_title | escape }}</h3>
                <div class="travel-contact-item-text">
                  {{ section.settings.hours_text | newline_to_br }}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action CTAs (WhatsApp & Call) -->
        <div class="travel-contact-action-cards">
          <!-- WhatsApp Card -->
          <div class="travel-contact-action-card travel-contact-action-card--wa">
            <div class="travel-action-icon-circle travel-action-icon-circle--wa" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div class="travel-action-content">
              <h4 class="travel-action-title">{{ section.settings.wa_heading | escape }}</h4>
              <p class="travel-action-sub">{{ section.settings.wa_sub | escape }}</p>
              <a
                href="https://wa.me/{{ section.settings.wa_number | replace: '+', '' | replace: ' ', '' }}"
                class="travel-action-btn travel-action-btn--wa"
                target="_blank"
                rel="noopener"
              >
                {{ section.settings.wa_btn_label | escape }}
              </a>
            </div>
          </div>

          <!-- Call Card -->
          <div class="travel-contact-action-card travel-contact-action-card--call">
            <div class="travel-action-icon-circle travel-action-icon-circle--call" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="travel-action-content">
              <h4 class="travel-action-title">{{ section.settings.call_heading | escape }}</h4>
              <p class="travel-action-sub">{{ section.settings.call_sub | escape }}</p>
              <a
                href="tel:{{ section.settings.call_number | replace: ' ', '' }}"
                class="travel-action-btn travel-action-btn--call"
              >
                {{ section.settings.call_btn_label | escape }}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="travel-contact-col travel-contact-col--right">
        <!-- Send Us a Message Form Card -->
        <div class="travel-contact-card travel-contact-form-card">
          <h2 class="travel-contact-heading">{{ section.settings.form_heading | escape }}</h2>

          {%- form 'contact', id: 'ContactForm', class: 'travel-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="travel-form-status travel-form-status--success" role="status">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Thank you! Your message has been sent successfully. We will contact you soon.</span>
              </div>
            {%- elsif form.errors -%}
              <div class="travel-form-status travel-form-status--error" role="alert">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>Please fill in all required fields properly.</span>
              </div>
            {%- endif -%}

            <!-- 1. Full Name -->
            <div class="travel-form-group">
              <label for="ContactForm-name" class="travel-form-label">
                Full Name <span class="travel-form-required">*</span>
              </label>
              <input
                type="text"
                id="ContactForm-name"
                name="contact[name]"
                class="travel-form-input"
                placeholder="Enter your name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                required
              >
            </div>

            <!-- 2. Email Address -->
            <div class="travel-form-group">
              <label for="ContactForm-email" class="travel-form-label">
                Email Address <span class="travel-form-required">*</span>
              </label>
              <input
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                class="travel-form-input"
                placeholder="you@example.com"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                spellcheck="false"
                autocapitalize="off"
                required
              >
            </div>

            <!-- 3. Phone Number with +91 indicator -->
            <div class="travel-form-group">
              <label for="ContactForm-phone" class="travel-form-label">
                Phone Number
              </label>
              <div class="travel-phone-input-wrap">
                <div class="travel-phone-prefix" aria-label="Country Code">
                  <span>+91</span>
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="1 1 5 5 9 1"></polyline>
                  </svg>
                </div>
                <input
                  type="tel"
                  id="ContactForm-phone"
                  name="contact[phone]"
                  class="travel-form-input travel-form-input--phone"
                  placeholder="Enter phone number"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  pattern="[0-9\-+() ]*"
                >
              </div>
            </div>

            <!-- 4. Message -->
            <div class="travel-form-group">
              <label for="ContactForm-body" class="travel-form-label">
                Message <span class="travel-form-required">*</span>
              </label>
              <textarea
                id="ContactForm-body"
                name="contact[body]"
                class="travel-form-textarea"
                rows="4"
                placeholder="How can we help you?"
                required
              >{{ form.body }}</textarea>
            </div>

            <!-- 5. Submit Button -->
            <button type="submit" class="travel-form-submit-btn">
              <span>Send Message</span>
            </button>
          {%- endform -%}
        </div>

        <!-- Map & Location Card -->
        <div class="travel-contact-map-card">
          <div class="travel-map-frame-wrap">
            <iframe
              class="travel-map-iframe"
              src="{{ section.settings.map_embed_url | default: 'https://maps.google.com/maps?q=Park%20Street%20Kolkata&t=&z=14&ie=UTF8&iwloc=&output=embed' }}"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Office Location Map"
            ></iframe>
          </div>
          <div class="travel-map-location-footer">
            <div class="travel-map-pin-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="travel-map-location-info">
              <h4 class="travel-map-location-title">Our Location</h4>
              <p class="travel-map-location-address">
                {{ section.settings.map_location_text | default: '123 Travel Lane, Park Street, Kolkata, WB 700016' }}
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Travel Contact Page",
  "class": "travel-contact-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "hero_fallback_image",
      "label": "Hero Fallback Asset",
      "default": "hero-maldives.jpg"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Banner Overlay Darkness (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 35
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "We'd love to hear from you"
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Info Heading",
      "default": "Get In Touch"
    },
    {
      "type": "text",
      "id": "office_title",
      "label": "Office Title",
      "default": "Our Office"
    },
    {
      "type": "textarea",
      "id": "office_address",
      "label": "Office Address",
      "default": "123 Travel Lane, Park Street\nKolkata, West Bengal 700016, India"
    },
    {
      "type": "text",
      "id": "phone_title",
      "label": "Phone Title",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Primary Phone",
      "default": "+91 98765 43210"
    },
    {
      "type": "text",
      "id": "phone_whatsapp",
      "label": "WhatsApp Phone",
      "default": "+91 87654 32109"
    },
    {
      "type": "text",
      "id": "email_title",
      "label": "Email Title",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "hello@tourandtravelwings.com"
    },
    {
      "type": "text",
      "id": "hours_title",
      "label": "Hours Title",
      "default": "Business Hours"
    },
    {
      "type": "textarea",
      "id": "hours_text",
      "label": "Business Hours Text",
      "default": "Mon - Fri: 9:00 AM - 7:00 PM\nSat - Sun: 10:00 AM - 5:00 PM"
    },
    {
      "type": "header",
      "content": "WhatsApp CTA Card"
    },
    {
      "type": "text",
      "id": "wa_heading",
      "label": "WhatsApp Card Heading",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "text",
      "id": "wa_sub",
      "label": "WhatsApp Card Subtitle",
      "default": "Get instant support for your travel plans."
    },
    {
      "type": "text",
      "id": "wa_number",
      "label": "WhatsApp Number",
      "default": "+91 87654 32109"
    },
    {
      "type": "text",
      "id": "wa_btn_label",
      "label": "WhatsApp Button Label",
      "default": "Chat Now"
    },
    {
      "type": "header",
      "content": "Call Us CTA Card"
    },
    {
      "type": "text",
      "id": "call_heading",
      "label": "Call Card Heading",
      "default": "Call Us"
    },
    {
      "type": "text",
      "id": "call_sub",
      "label": "Call Card Subtitle",
      "default": "Speak with our travel experts."
    },
    {
      "type": "text",
      "id": "call_number",
      "label": "Call Number",
      "default": "+91 98765 43210"
    },
    {
      "type": "text",
      "id": "call_btn_label",
      "label": "Call Button Label",
      "default": "Call Now"
    },
    {
      "type": "header",
      "content": "Contact Form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Send Us a Message"
    },
    {
      "type": "header",
      "content": "Location Map"
    },
    {
      "type": "text",
      "id": "map_embed_url",
      "label": "Google Maps Embed URL",
      "default": "https://maps.google.com/maps?q=Park%20Street%20Kolkata&t=&z=14&ie=UTF8&iwloc=&output=embed"
    },
    {
      "type": "text",
      "id": "map_location_text",
      "label": "Map Location Subtext",
      "default": "123 Travel Lane, Park Street, Kolkata, WB 700016"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Travel Contact Page"
    }
  ]
}
{% endschema %}

